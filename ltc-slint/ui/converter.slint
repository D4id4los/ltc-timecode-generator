import { AppColors } from "./theme.slint";
import { FileGroupInfo } from "./types.slint";
import { ScrollView } from "std-widgets.slint";

export component ConverterSection {
    in-out property <bool> has-ffmpeg: false;
    in-out property <string> ffmpeg-error: "";
    in-out property <bool> ffmpeg-probing: false;
    in-out property <string> selected-folder: "";
    in-out property <[FileGroupInfo]> file-groups: [];
    in-out property <int> selected-group-idx: -1;
    in-out property <int> num-channels: 0;
    in-out property <[int]> channel-map: [];
    in-out property <bool> split-tracks: false;
    in-out property <bool> drop-ltc-track: false;
    in-out property <bool> concat-audio: false;
    in-out property <bool> generate-synthetic-video: false;
    in-out property <bool> is-video-recording: false;
    in-out property <bool> copy-video: false;
    in-out property <string> container: "mkv";
    in-out property <string> video-encoder: "libsvtav1";
    in-out property <string> audio-encoder: "pcm_s24le";
    in-out property <string> output-folder: "";
    in-out property <string> filename-prefix: "";
    in-out property <string> audio-suffix-template: "_audio_track{:01d}";
    in-out property <string> video-suffix-template: "_video_clip{:02d}";
    in-out property <string> conv-status: "idle";
    in-out property <float> conv-progress: 0.0;
    in-out property <string> conv-log: "";
    in-out property <string> sanity-msg: "";

    in-out property <[string]> container-options: [];
    in-out property <[string]> video-encoder-options: [];
    in-out property <[string]> audio-encoder-options: [];
    in-out property <[string]> pattern-options: ["TASCAM", "* (any)"];
    in-out property <int> selected-pattern: 0;
    in-out property <int> open-popup: -1;
    callback select-pattern(int);

    // ── Trim to first LTC ──
    in-out property <bool> trim-to-first-ltc: false;
    in-out property <float> trim-offset-secs: 0.0;
    callback toggle-trim-ltc;

    // ── LTC detection properties ──
    in-out property <int> ltc-file-idx: 1;
    in-out property <[string]> ltc-file-names: [];
    in-out property <string> ltc-status: "";
    in-out property <string> ltc-result-text: "";
    in-out property <string> ltc-error: "";
    in-out property <[string]> decode-fps-options: [];
    in-out property <int> decode-fps-index: 1;
    in-out property <float> ltc-decode-progress: 0.0;

    // Video audio probe (streams + channels)
    in-out property <[string]> ltc-channel-names: [];
    in-out property <int> ltc-selected-stream: 0;
    in-out property <int> ltc-selected-channel: 0;
    callback channel-selected(int);

    callback detect-ltc;
    callback decode-fps-selected(int);
    callback cancel-decode;
    callback copy-ltc-report;

    callback select-folder;
    callback select-group(int);
    callback map-cell-clicked(int, int);
    callback start-convert;
    callback cancel-convert;
    callback copy-log;
    callback reset-conv;
    callback container-selected(int);
    callback video-selected(int);
    callback audio-selected(int);
    callback toggle-split-tracks;
    callback toggle-drop-ltc-track;
    callback toggle-concat-audio;
    callback toggle-synthetic-video;
    callback toggle-copy-video;
    callback select-output-folder;
    callback filename-prefix-changed(string);
    callback audio-suffix-changed(string);
    callback video-suffix-changed(string);

    Rectangle {
        border-radius: 12px;
        border-width: 1.5px;
        border-color: AppColors.border-main;
        background: AppColors.card-bg;

        ScrollView {
            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // ── Step 1: Select Files ──
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        width: 22px; height: 22px; border-radius: 4px;
                        background: AppColors.accent;
                        Text { text: "1"; color: black; font-size: 11px; font-weight: 700;
                               horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "SELECT FILES"; color: AppColors.text-title; font-size: 12px; font-weight: 700; }
                }

                HorizontalLayout { spacing: 6px;
                    Text { text: "Naming pattern:"; color: AppColors.text-muted; font-size: 10px; font-weight: 600; }
                    Rectangle {
                        border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                        background: AppColors.deep-bg; min-height: 24px; max-width: 140px;
                        TouchArea { clicked => { root.open-popup = root.open-popup == 3 ? -1 : 3; } }
                        HorizontalLayout { padding: 4px; spacing: 4px;
                            Text {
                                text: root.pattern-options[root.selected-pattern];
                                color: AppColors.text-title; font-size: 10px; font-family: "monospace"; font-weight: 700;
                                horizontal-stretch: 1; vertical-alignment: center;
                            }
                            Text { text: "▼"; color: AppColors.text-muted; font-size: 8px; vertical-alignment: center; }
                        }
                    }
                    if (root.open-popup == 3) : VerticalLayout { spacing: 1px; padding-top: 2px;
                        for opt[idx] in root.pattern-options : Rectangle {
                            border-radius: 4px; border-width: 1px; border-color: AppColors.border-main;
                            background: AppColors.deep-bg; min-height: 24px;
                            TouchArea {
                                clicked => {
                                    root.open-popup = -1;
                                    root.select-pattern(idx);
                                }
                            }
                            Text { text: opt; color: AppColors.text-title; font-size: 9px; font-family: "monospace"; font-weight: 600;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                Rectangle {
                    border-radius: 8px;
                    background: AppColors.deep-bg;
                    border-width: 1px; border-color: AppColors.border-main;
                    min-height: 32px;
                    TouchArea { clicked => { root.select-folder(); } }
                    HorizontalLayout { padding: 8px; spacing: 6px;
                        Text { text: "📂"; font-size: 12px; }
                        Text {
                            text: root.selected-pattern == 0
                                ? (root.selected-folder == "" ? "Select Folder…" : root.selected-folder)
                                : (root.file-groups.length > 0 ? root.selected-folder : "Select Files…");
                            color: root.selected-folder == "" ? AppColors.text-muted : AppColors.text-title;
                            font-size: 10px; font-family: "monospace";
                            horizontal-stretch: 1; vertical-alignment: center;
                        }
                    }
                }

                if (root.file-groups.length > 0) : VerticalLayout { spacing: 4px;
                    Text {
                        text: root.selected-pattern == 0 ? "Recording:" : "Selected files:";
                        color: AppColors.text-muted; font-size: 10px; font-weight: 600;
                    }
                    for group[idx] in root.file-groups : Rectangle {
                        border-radius: 6px;
                        background: AppColors.accent;
                        opacity: root.selected-group-idx == idx ? 0.15 : 1.0;
                        border-width: 1px;
                        border-color: root.selected-group-idx == idx ? AppColors.accent : AppColors.border-main;
                        min-height: 28px;
                        TouchArea { clicked => { root.select-group(idx); } }
                        HorizontalLayout { padding: 6px; spacing: 6px;
                            Text { text: group.prefix; color: AppColors.text-title; font-size: 10px; font-family: "monospace"; font-weight: 700; }
                            Text {
                                text: root.selected-pattern == 0
                                    ? "(" + group.channel-count + " ch)"
                                    : "(" + group.channel-count + " file" + (group.channel-count == 1 ? "" : "s") + ")";
                                color: AppColors.text-muted; font-size: 9px;
                                horizontal-stretch: 1; vertical-alignment: center;
                            }
                        }
                    }
                }

                // ── LTC Verification ──
                if (root.selected-group-idx >= 0) : VerticalLayout { spacing: 8px;
                    HorizontalLayout { spacing: 6px;
                        Rectangle {
                            width: 22px; height: 22px; border-radius: 4px;
                            background: AppColors.accent;
                            Text { text: "L"; color: black; font-size: 11px; font-weight: 700;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "VERIFY LTC TRACK"; color: AppColors.text-title; font-size: 12px; font-weight: 700; }
                    }
                    Text {
                        text: "Select a file and click Detect to verify LTC timecode is readable.";
                        color: AppColors.text-muted; font-size: 9px; wrap: word-wrap;
                    }
                    HorizontalLayout { spacing: 4px;
                        // File/track selector
                        Rectangle {
                            border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                            background: AppColors.deep-bg; min-height: 28px;
                            horizontal-stretch: 1;
                            TouchArea {
                                clicked => {
                                    if (root.ltc-file-idx + 1 < root.ltc-file-names.length) {
                                        root.ltc-file-idx += 1;
                                    } else {
                                        root.ltc-file-idx = 0;
                                    }
                                }
                            }
                            Text {
                                text: root.ltc-file-names.length > 0
                                    ? (root.is-video-recording
                                        ? "Track " + (root.ltc-file-idx + 1)
                                        : root.ltc-file-names[root.ltc-file-idx])
                                    : "(no files)";
                                color: AppColors.text-title; font-size: 10px; font-family: "monospace";
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        // Channel selector (shown for video when probe data is available)
                        if (root.is-video-recording && root.ltc-channel-names.length > 0) : Rectangle {
                            border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                            background: AppColors.deep-bg; min-height: 28px; max-width: 80px;
                            TouchArea {
                                clicked => {
                                    if (root.ltc-selected-channel + 1 < root.ltc-channel-names.length) {
                                        root.ltc-selected-channel += 1;
                                        root.channel-selected(root.ltc-selected-channel);
                                    } else {
                                        root.ltc-selected-channel = 0;
                                        root.channel-selected(0);
                                    }
                                }
                            }
                            Text {
                                text: root.ltc-channel-names.length > 0
                                    ? root.ltc-channel-names[root.ltc-selected-channel]
                                    : "(ch)";
                                color: AppColors.text-title; font-size: 10px; font-family: "monospace";
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        // FPS pills
                        for opt[idx] in root.decode-fps-options : Rectangle {
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.decode-fps-index == idx ? AppColors.accent : AppColors.border-main;
                            background: root.decode-fps-index == idx ? AppColors.accent : AppColors.deep-bg;
                            min-width: 40px; min-height: 28px;
                            TouchArea {
                                clicked => { root.decode-fps-selected(idx); }
                            }
                            Text {
                                text: opt;
                                color: root.decode-fps-index == idx ? black : AppColors.text-title;
                                font-size: 9px; font-family: "monospace"; font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        if (root.ltc-status == "detecting") : VerticalLayout { spacing: 4px;
                            Rectangle {
                                height: 8px; border-radius: 4px; background: AppColors.deep-bg;
                                Rectangle {
                                    height: 8px; border-radius: 4px; background: AppColors.accent;
                                    width: parent.width * root.ltc-decode-progress;
                                }
                            }
                            Rectangle {
                                border-radius: 6px; background: AppColors.red;
                                min-height: 24px; max-width: 80px;
                                TouchArea { clicked => { root.cancel-decode(); } }
                                Text {
                                    text: "✕ Cancel";
                                    color: white; font-size: 10px; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                        }
                        if (root.ltc-status != "detecting") : Rectangle {
                            border-radius: 6px;
                            background: AppColors.accent;
                            min-height: 28px; max-width: 100px;
                            TouchArea {
                                enabled: root.ltc-file-names.length > 0;
                                clicked => { root.detect-ltc(); }
                            }
                            Text {
                                text: "🔍 Detect";
                                color: black;
                                font-size: 11px; font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }

                    // Result display
                    if (root.ltc-status == "success" || root.ltc-status == "low_confidence" || root.ltc-status == "no_sync") : Rectangle {
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.ltc-status == "success" ? AppColors.green : (root.ltc-status == "low_confidence" ? AppColors.amber : AppColors.red);
                        min-height: 40px;
                        Rectangle {
                            border-radius: 6px;
                            background: root.ltc-status == "success" ? AppColors.green : (root.ltc-status == "low_confidence" ? AppColors.amber : AppColors.red);
                            opacity: 0.1;
                            width: 100%; height: 100%;
                        }
                        VerticalLayout { padding: 8px; spacing: 4px;
                            Text {
                                text: root.ltc-status == "success" ? "✅ LTC detected" : (root.ltc-status == "low_confidence" ? "⚠️ LTC detected (low confidence)" : "❌ No LTC found");
                                color: root.ltc-status == "success" ? AppColors.green : (root.ltc-status == "low_confidence" ? AppColors.amber : AppColors.red);
                                font-size: 10px; font-weight: 700; wrap: word-wrap;
                            }
                            Text {
                                text: root.ltc-result-text;
                                color: AppColors.text-title; font-size: 9px; font-family: "monospace"; wrap: word-wrap;
                            }
                            if (root.ltc-status == "success" || root.ltc-status == "low_confidence") : Rectangle {
                                border-radius: 6px; background: AppColors.nested-bg;
                                min-height: 26px; max-width: 120px;
                                TouchArea { clicked => { root.copy-ltc-report(); } }
                                Text {
                                    text: "📋 Copy Report";
                                    color: AppColors.text-title; font-size: 9px; font-weight: 600;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                        }
                    }

                    if (root.ltc-error != "") : Rectangle {
                        border-radius: 6px;
                        border-width: 1px; border-color: AppColors.red;
                        min-height: 20px;
                        Rectangle {
                            height: 20px;
                            Text {
                                text: "❌ " + root.ltc-error;
                                color: AppColors.red; font-size: 9px; wrap: word-wrap;
                                x: 6px; y: 4px;
                            }
                        }
                    }
                }

                // ── Step 2: Channel Splitting or Mapping ──
                if (root.num-channels > 0) : VerticalLayout { spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 22px; height: 22px; border-radius: 4px;
                            background: AppColors.accent;
                            Text { text: "2"; color: black; font-size: 11px; font-weight: 700;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "CHANNEL SPLITTING OR MAPPING"; color: AppColors.text-title; font-size: 12px; font-weight: 700; }
                    }
                    Text {
                        text: "Click a radio button to swap the input channel (row) with the channel currently mapped to the selected output (column).";
                        color: AppColors.text-muted; font-size: 9px; wrap: word-wrap;
                    }

                    // Matrix header
                    HorizontalLayout { spacing: 4px;
                        Rectangle { width: 36px; height: 20px; }
                        for col in root.num-channels : Rectangle {
                            width: 30px; height: 20px;
                            Text { text: "OUT " + (col + 1); color: AppColors.text-muted;
                                   font-size: 8px; font-weight: 600;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    // Matrix rows
                    for row in root.num-channels : HorizontalLayout { spacing: 4px;
                        Rectangle {
                            width: 36px; height: 30px;
                            Text { text: "CH " + (row + 1); color: AppColors.text-title;
                                   font-size: 9px; font-family: "monospace"; font-weight: 600;
                                   vertical-alignment: center; }
                        }
                        for col in root.num-channels : Rectangle {
                            width: 30px; height: 30px;
                            border-radius: 15px;
                            border-width: root.channel-map[row] == col ? 2.5px : 1px;
                            border-color: root.channel-map[row] == col ? AppColors.accent : AppColors.border-main;
                            background: root.channel-map[row] == col ? AppColors.accent : AppColors.deep-bg;
                            opacity: root.channel-map[row] == col ? 0.35 : 1.0;
                            TouchArea { clicked => { root.map-cell-clicked(row, col); } }
                        }
                    }

                    // Split / Drop checkboxes
                    HorizontalLayout { spacing: 12px; padding-top: 4px;
                        HorizontalLayout { spacing: 4px;
                            Rectangle {
                                width: 14px; height: 14px; border-radius: 3px;
                                border-width: 1px;
                                border-color: root.split-tracks ? AppColors.accent : AppColors.border-main;
                                background: root.split-tracks ? AppColors.accent : transparent;
                                TouchArea { clicked => { root.toggle-split-tracks(); } }
                                Text {
                                    visible: root.split-tracks;
                                    text: "✓"; color: black; font-size: 10px; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            Text { text: "Split tracks into separate files"; color: AppColors.text-title; font-size: 9px; vertical-alignment: center; }
                        }
                        HorizontalLayout { spacing: 4px;
                            Rectangle {
                                width: 14px; height: 14px; border-radius: 3px;
                                border-width: 1px;
                                border-color: root.drop-ltc-track ? AppColors.accent : AppColors.border-main;
                                background: root.drop-ltc-track ? AppColors.accent : transparent;
                                TouchArea { clicked => { root.toggle-drop-ltc-track(); } }
                                Text {
                                    visible: root.drop-ltc-track;
                                    text: "✓"; color: black; font-size: 10px; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            Text { text: "Drop LTC track"; color: AppColors.text-title; font-size: 9px; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            visible: root.is-video-recording && root.split-tracks;
                            spacing: 4px;
                            Rectangle {
                                width: 14px; height: 14px; border-radius: 3px;
                                border-width: 1px;
                                border-color: root.concat-audio ? AppColors.accent : AppColors.border-main;
                                background: root.concat-audio ? AppColors.accent : transparent;
                                TouchArea { clicked => { root.toggle-concat-audio(); } }
                                Text {
                                    visible: root.concat-audio;
                                    text: "✓"; color: black; font-size: 10px; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            Text { text: "Concatenate audio across clips"; color: AppColors.text-title; font-size: 9px; vertical-alignment: center; }
                        }
                    }
                }

                // ── Step 3: Output Format ──
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        width: 22px; height: 22px; border-radius: 4px;
                        background: AppColors.accent;
                        Text { text: "3"; color: black; font-size: 11px; font-weight: 700;
                               horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "OUTPUT FORMAT"; color: AppColors.text-title; font-size: 12px; font-weight: 700; }
                }

                // Video Format / Audio Format columns
                HorizontalLayout { spacing: 16px;
                    // ── Video Format column ──
                    VerticalLayout { horizontal-stretch: 1; spacing: 6px;
                        Text { text: "VIDEO FORMAT"; color: AppColors.text-title; font-size: 10px; font-weight: 700; }
                        // Stream copy checkbox (video recordings)
                        if (root.is-video-recording) : HorizontalLayout { spacing: 4px;
                            Rectangle {
                                width: 14px; height: 14px; border-radius: 3px;
                                border-width: 1px;
                                border-color: root.copy-video ? AppColors.accent : AppColors.border-main;
                                background: root.copy-video ? AppColors.accent : transparent;
                                TouchArea { clicked => { root.toggle-copy-video(); } }
                                Text {
                                    visible: root.copy-video;
                                    text: "✓"; color: black; font-size: 10px; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            Text { text: "Leave video encoding untouched (stream copy)"; color: AppColors.text-title; font-size: 9px; vertical-alignment: center; }
                        }
                        if (root.is-video-recording && root.copy-video) : Text {
                            text: "Video is copied without re-encoding (much faster).\nCuts snap to the nearest keyframe before the trim point.";
                            color: AppColors.text-muted; font-size: 8px; wrap: word-wrap;
                        }
                        // Container
                        VerticalLayout { spacing: 0px;
                            Rectangle {
                                opacity: root.copy-video ? 0.4 : 1.0;
                                border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                                background: AppColors.deep-bg; min-height: 28px;
                                TouchArea { clicked => { if (!root.copy-video) { root.open-popup = root.open-popup == 0 ? -1 : 0; } } }
                                VerticalLayout { padding: 4px; spacing: 2px;
                                    Text { text: root.copy-video ? "Container (matches input)" : "Container"; color: AppColors.text-muted; font-size: 8px; font-weight: 600; }
                                    Text { text: root.container; color: AppColors.text-title; font-size: 10px; font-family: "monospace"; font-weight: 700; }
                                }
                            }
                            if (root.open-popup == 0) : VerticalLayout { spacing: 1px; padding-top: 2px;
                                for opt[idx] in root.container-options : Rectangle {
                                    border-radius: 4px; border-width: 1px; border-color: AppColors.border-main;
                                    background: AppColors.deep-bg; min-height: 24px;
                                    TouchArea {
                                        clicked => {
                                            root.open-popup = -1;
                                            root.container-selected(idx);
                                        }
                                    }
                                    Text { text: opt; color: AppColors.text-title; font-size: 9px; font-family: "monospace"; font-weight: 600;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                        // Video codec
                        VerticalLayout { spacing: 0px;
                            Rectangle {
                                opacity: root.copy-video ? 0.4 : 1.0;
                                border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                                background: AppColors.deep-bg; min-height: 28px;
                                TouchArea { clicked => { if (!root.copy-video) { root.open-popup = root.open-popup == 1 ? -1 : 1; } } }
                                VerticalLayout { padding: 4px; spacing: 2px;
                                    Text { text: root.copy-video ? "Video codec (stream copied)" : "Video codec"; color: AppColors.text-muted; font-size: 8px; font-weight: 600; }
                                    Text { text: root.copy-video ? "copy (untouched)" : root.video-encoder; color: AppColors.text-title; font-size: 10px; font-family: "monospace"; font-weight: 700; }
                                }
                            }
                            if (root.open-popup == 1) : VerticalLayout { spacing: 1px; padding-top: 2px;
                                for opt[idx] in root.video-encoder-options : Rectangle {
                                    border-radius: 4px; border-width: 1px; border-color: AppColors.border-main;
                                    background: AppColors.deep-bg; min-height: 24px;
                                    TouchArea {
                                        clicked => {
                                            root.open-popup = -1;
                                            root.video-selected(idx);
                                        }
                                    }
                                    Text { text: opt; color: AppColors.text-title; font-size: 9px; font-family: "monospace"; font-weight: 600;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                        // Synthetic video checkbox (audio-only recordings)
                        if (!root.is-video-recording) : HorizontalLayout { spacing: 4px;
                            Rectangle {
                                width: 14px; height: 14px; border-radius: 3px;
                                border-width: 1px;
                                border-color: root.generate-synthetic-video ? AppColors.accent : AppColors.border-main;
                                background: root.generate-synthetic-video ? AppColors.accent : transparent;
                                TouchArea { clicked => { root.toggle-synthetic-video(); } }
                                Text {
                                    visible: root.generate-synthetic-video;
                                    text: "✓"; color: black; font-size: 10px; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "Generate synthetic video";
                                color: AppColors.text-title; font-size: 9px; vertical-alignment: center;
                            }
                        }
                    }

                    // ── Audio Format column ──
                    VerticalLayout { horizontal-stretch: 1; spacing: 6px;
                        Text { text: "AUDIO FORMAT"; color: AppColors.text-title; font-size: 10px; font-weight: 700; }
                        // Audio encoder
                        VerticalLayout { spacing: 0px;
                            Rectangle {
                                border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                                background: AppColors.deep-bg; min-height: 28px;
                                TouchArea { clicked => { root.open-popup = root.open-popup == 2 ? -1 : 2; } }
                                VerticalLayout { padding: 4px; spacing: 2px;
                                    Text { text: "Audio encoder"; color: AppColors.text-muted; font-size: 8px; font-weight: 600; }
                                    Text { text: root.audio-encoder; color: AppColors.text-title; font-size: 10px; font-family: "monospace"; font-weight: 700; }
                                }
                            }
                            if (root.open-popup == 2) : VerticalLayout { spacing: 1px; padding-top: 2px;
                                for opt[idx] in root.audio-encoder-options : Rectangle {
                                    border-radius: 4px; border-width: 1px; border-color: AppColors.border-main;
                                    background: AppColors.deep-bg; min-height: 24px;
                                    TouchArea {
                                        clicked => {
                                            root.open-popup = -1;
                                            root.audio-selected(idx);
                                        }
                                    }
                                    Text { text: opt; color: AppColors.text-title; font-size: 9px; font-family: "monospace"; font-weight: 600;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // Sanity / compatibility message
                if (root.sanity-msg != "") : Rectangle {
                    border-radius: 6px;
                    border-width: 1px; border-color: AppColors.amber;
                    min-height: 24px;
                    Rectangle {
                        border-radius: 6px;
                        background: AppColors.amber;
                        opacity: 0.15;
                        width: 100%; height: 100%;
                    }
                    HorizontalLayout { padding: 8px; spacing: 6px;
                        Text { text: "⚠"; color: AppColors.amber; font-size: 12px; }
                        Text { text: root.sanity-msg; color: AppColors.amber; font-size: 10px; wrap: word-wrap; horizontal-stretch: 1; }
                    }
                }
                if (!root.has-ffmpeg && root.ffmpeg-error == "" && root.ffmpeg-probing) : Rectangle {
                    border-radius: 6px;
                    border-width: 1px; border-color: AppColors.border-main;
                    min-height: 24px;
                    HorizontalLayout { padding: 8px; spacing: 6px;
                        Text { text: "⏳"; color: AppColors.text-muted; font-size: 12px; }
                        Text { text: "Probing ffmpeg capabilities…"; color: AppColors.text-muted; font-size: 10px; wrap: word-wrap; horizontal-stretch: 1; }
                    }
                }
                if (!root.has-ffmpeg && root.ffmpeg-error != "") : Rectangle {
                    border-radius: 6px;
                    border-width: 1px; border-color: AppColors.red;
                    min-height: 24px;
                    Rectangle {
                        border-radius: 6px;
                        background: AppColors.red;
                        opacity: 0.1;
                        width: 100%; height: 100%;
                    }
                    HorizontalLayout { padding: 8px; spacing: 6px;
                        Text { text: "✗"; color: AppColors.red; font-size: 12px; }
                        Text { text: root.ffmpeg-error; color: AppColors.red; font-size: 10px; wrap: word-wrap; horizontal-stretch: 1; }
                    }
                }

                // ── Step 4: Output File ──
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        width: 22px; height: 22px; border-radius: 4px;
                        background: AppColors.accent;
                        Text { text: "4"; color: black; font-size: 11px; font-weight: 700;
                               horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "OUTPUT FILE"; color: AppColors.text-title; font-size: 12px; font-weight: 700; }
                }

                // Output folder
                HorizontalLayout { spacing: 6px;
                    Rectangle {
                        border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                        background: AppColors.deep-bg; min-height: 28px; horizontal-stretch: 1;
                        HorizontalLayout { padding: 8px; spacing: 6px;
                            Text { text: "📁"; font-size: 12px; }
                            Text {
                                text: root.output-folder == "" ? "(No output folder selected)" : root.output-folder;
                                color: root.output-folder == "" ? AppColors.text-muted : AppColors.text-title;
                                font-size: 10px; font-family: "monospace"; horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle {
                        border-radius: 6px; background: AppColors.accent; min-height: 28px; max-width: 80px;
                        TouchArea { clicked => { root.select-output-folder(); } }
                        Text { text: "Browse…"; color: black; font-size: 10px; font-weight: 700;
                               horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                // Filename prefix
                HorizontalLayout { spacing: 6px;
                    Text { text: "Filename prefix:"; color: AppColors.text-muted; font-size: 10px; font-weight: 600;
                           vertical-alignment: center; min-width: 100px; }
                    Rectangle {
                        border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                        background: AppColors.deep-bg; min-height: 26px; horizontal-stretch: 1;
                        TextInput {
                            text: root.filename-prefix;
                            font-size: 10px; font-family: "monospace";
                            color: AppColors.text-title;
                            horizontal-alignment: left; vertical-alignment: center;
                            edited => { root.filename-prefix-changed(self.text); }
                        }
                    }
                }

                // Audio suffix
                HorizontalLayout { spacing: 6px;
                    Text { text: "Audio suffix:"; color: AppColors.text-muted; font-size: 10px; font-weight: 600;
                           vertical-alignment: center; min-width: 100px; }
                    Rectangle {
                        border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                        background: AppColors.deep-bg; min-height: 26px; horizontal-stretch: 1;
                        TextInput {
                            text: root.audio-suffix-template;
                            font-size: 10px; font-family: "monospace";
                            color: AppColors.text-title;
                            horizontal-alignment: left; vertical-alignment: center;
                            edited => { root.audio-suffix-changed(self.text); }
                        }
                    }
                }

                // Video suffix
                HorizontalLayout { spacing: 6px;
                    Text { text: "Video suffix:"; color: AppColors.text-muted; font-size: 10px; font-weight: 600;
                           vertical-alignment: center; min-width: 100px; }
                    Rectangle {
                        border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                        background: AppColors.deep-bg; min-height: 26px; horizontal-stretch: 1;
                        TextInput {
                            text: root.video-suffix-template;
                            font-size: 10px; font-family: "monospace";
                            color: AppColors.text-title;
                            horizontal-alignment: left; vertical-alignment: center;
                            edited => { root.video-suffix-changed(self.text); }
                        }
                    }
                }

                // ── Trim to first LTC ──
                HorizontalLayout { spacing: 6px; padding-top: 4px;
                    property <bool> ltc-done: root.ltc-status != "" && root.ltc-status != "detecting";
Rectangle {
                            width: 16px; height: 16px; border-radius: 3px;
                            border-width: 1px;
                            border-color: root.trim-to-first-ltc ? AppColors.accent : AppColors.border-main;
                            background: root.trim-to-first-ltc ? AppColors.accent : transparent;
                            opacity: ltc-done ? 1.0 : 0.4;
                            TouchArea {
                                enabled: ltc-done;
                            clicked => { root.toggle-trim-ltc(); }
                        }
                        Text {
                            visible: root.trim-to-first-ltc;
                            text: "✓"; color: black; font-size: 12px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "Cut and Set Start Time to First LTC Frame";
                        color: ltc-done ? AppColors.text-title : AppColors.text-muted;
                        font-size: 10px; vertical-alignment: center;
                    }
                    Text {
                        visible: root.trim-to-first-ltc && root.trim-offset-secs > 0.001;
                        text: "(trim " + (root.trim-offset-secs * 1000) + "ms of silence)";
                        color: AppColors.text-muted; font-size: 9px; vertical-alignment: center;
                    }
                    Text {
                        visible: root.ltc-status == "";
                        text: "(Detect LTC first)";
                        color: AppColors.text-muted; font-size: 9px; vertical-alignment: center;
                    }
                }

                // ── Convert Button ──
                if (root.conv-status == "running") : Rectangle {
                    border-radius: 8px; background: AppColors.red; min-height: 40px;
                    TouchArea { clicked => { root.cancel-convert(); } }
                    Text { text: "■ CANCEL CONVERSION"; color: white; font-size: 13px; font-weight: 700;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                if (root.conv-status != "running") : Rectangle {
                    border-radius: 8px;
                    background: (root.has-ffmpeg && root.selected-group-idx >= 0 && root.output-folder != "" && root.filename-prefix != "" && root.sanity-msg == "") ? AppColors.accent : AppColors.nested-bg;
                    min-height: 40px;
                    TouchArea {
                        enabled: root.has-ffmpeg && root.selected-group-idx >= 0 && root.output-folder != "" && root.filename-prefix != "" && root.sanity-msg == "";
                        clicked => { root.start-convert(); }
                    }
                    Text {
                        text: root.is-video-recording
                            ? "CONVERT VIDEO CLIPS"
                            : (root.generate-synthetic-video ? "CONVERT WITH SYNTHETIC VIDEO" : "CONVERT AUDIO FILES");
                        color: black; font-size: 13px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }

                // ── Progress / Log ──
                if (root.conv-status == "running") : VerticalLayout { spacing: 4px;
                    Text { text: "Converting…"; color: AppColors.text-title; font-size: 11px; font-weight: 700; }
                    Rectangle {
                        height: 8px; border-radius: 4px; background: AppColors.deep-bg;
                        Rectangle {
                            height: 8px; border-radius: 4px; background: AppColors.accent;
                            width: parent.width * root.conv-progress;
                        }
                    }
                    Text { text: "ffmpeg output:"; color: AppColors.text-muted; font-size: 9px; font-weight: 600; }
                    Rectangle {
                        border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                        background: #0D0D0F; min-height: 80px; max-height: 120px;
                        ScrollView {
                            Text {
                                text: root.conv-log == "" ? "(waiting for output…)" : root.conv-log;
                                color: #88CC88; font-size: 9px; font-family: "monospace";
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if (root.conv-status == "completed") : VerticalLayout { spacing: 6px;
                    Rectangle {
                        border-radius: 6px;
                        border-width: 1px; border-color: AppColors.green;
                        min-height: 40px;
                        Rectangle {
                            border-radius: 6px;
                            background: AppColors.green;
                            opacity: 0.1;
                            width: 100%; height: 100%;
                        }
                        HorizontalLayout { padding: 10px; spacing: 8px;
                            Text { text: "✓"; color: AppColors.green; font-size: 16px; }
                            VerticalLayout { spacing: 2px;
                                Text { text: "Conversion completed successfully!"; color: AppColors.green; font-size: 11px; font-weight: 700; }
                                Text { text: "Files saved to: " + root.output-folder + "/" + root.filename-prefix; color: AppColors.text-muted; font-size: 10px; wrap: word-wrap; }
                            }
                        }
                    }
                    if (root.conv-log != "") : Rectangle {
                        border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                        background: #0D0D0F; min-height: 60px; max-height: 100px;
                        ScrollView {
                            Text { text: root.conv-log; color: #88CC88; font-size: 9px; font-family: "monospace"; wrap: word-wrap; }
                        }
                    }
                    Rectangle {
                        border-radius: 6px; background: AppColors.nested-bg; min-height: 28px; max-width: 200px;
                        TouchArea { clicked => { root.reset-conv(); } }
                        Text { text: "Start New Conversion"; color: AppColors.text-title; font-size: 10px; font-weight: 600;
                               horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                if (root.conv-status == "failed") : VerticalLayout { spacing: 6px;
                    Rectangle {
                        border-radius: 6px;
                        border-width: 1px; border-color: AppColors.red;
                        min-height: 40px;
                        Rectangle {
                            border-radius: 6px;
                            background: AppColors.red;
                            opacity: 0.1;
                            width: 100%; height: 100%;
                        }
                        HorizontalLayout { padding: 10px; spacing: 8px;
                            Text { text: "✗"; color: AppColors.red; font-size: 16px; }
                            Text { text: "Conversion failed"; color: AppColors.red; font-size: 11px; font-weight: 700; }
                        }
                    }
                    Rectangle {
                        border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                        background: #0D0D0F; min-height: 80px; max-height: 200px;
                        ScrollView {
                            Text { text: root.conv-log == "" ? "(no output)" : root.conv-log; color: #FF6666; font-size: 9px; font-family: "monospace"; wrap: word-wrap; }
                        }
                    }
                    HorizontalLayout { spacing: 8px;
                        Rectangle {
                            border-radius: 6px; background: AppColors.nested-bg; min-height: 28px; max-width: 140px;
                            TouchArea { clicked => { root.copy-log(); } }
                            Text { text: "📋 Copy Error Log"; color: AppColors.text-title; font-size: 10px; font-weight: 600;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            border-radius: 6px; background: AppColors.nested-bg; min-height: 28px; max-width: 120px;
                            TouchArea { clicked => { root.reset-conv(); } }
                            Text { text: "Try Again"; color: AppColors.text-title; font-size: 10px; font-weight: 600;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}