export struct LogEntry {
    timestamp: string,
    timecode: string,
    milliseconds: string,
    note: string,
}

export struct FrameRateOption {
    name: string,
    fps: float,
    drop-frame: bool,
    description: string,
}

export struct ToastData {
    id: int,
    message: string,
    toast-type: string,
    opacity: float,
}

export struct FileGroupInfo {
    prefix: string,
    files: [string],
    channel-count: int,
    duration-text: string,
}

export struct OffloadFileInfo {
    name: string,
    date-text: string,
    duration-text: string,
    size-text: string,
    selected: bool,
}

export struct OffloadCardInfo {
    mount: string,
    volume-label: string,
    device-name: string,
    name-source: string,
    media-file-count: int,
    total-bytes: string,
    files: [OffloadFileInfo],
    selected-count: int,
    selected-bytes: string,
    durations-version: int,
}

export struct OffloadDeviceStatus {
    device-name: string,
    state-text: string,
    files-total: int,
    files-done: int,
    progress: float,
    bytes-text: string,
    current-file: string,
    error: string,
}