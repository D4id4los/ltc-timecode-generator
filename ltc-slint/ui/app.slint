import { ScrollView, ComboBox, Slider, ListView, StandardListView } from "std-widgets.slint";

// ── Constants ───────────────────────────────────────────────────────────────

export global AppColors {
    in-out property <bool> theme-dark;

    // Dark theme source colors (set from Rust via gui_engine::theme::DARK)
    in property <color> dark-accent;
    in property <color> dark-app-bg;
    in property <color> dark-card-bg;
    in property <color> dark-deep-bg;
    in property <color> dark-nested-bg;
    in property <color> dark-text-main;
    in property <color> dark-text-title;
    in property <color> dark-text-muted;
    in property <color> dark-border-main;
    in property <color> dark-green;
    in property <color> dark-red;
    in property <color> dark-amber;
    in property <color> dark-clock-sep;

    // Light theme source colors (set from Rust via gui_engine::theme::LIGHT)
    in property <color> light-accent;
    in property <color> light-app-bg;
    in property <color> light-card-bg;
    in property <color> light-deep-bg;
    in property <color> light-nested-bg;
    in property <color> light-text-main;
    in property <color> light-text-title;
    in property <color> light-text-muted;
    in property <color> light-border-main;
    in property <color> light-green;
    in property <color> light-red;
    in property <color> light-amber;
    in property <color> light-clock-sep;

    // Active colors (computed, used by all widgets)
    in-out property <color> accent: root.theme-dark ? root.dark-accent : root.light-accent;
    in-out property <color> app-bg: root.theme-dark ? root.dark-app-bg : root.light-app-bg;
    in-out property <color> card-bg: root.theme-dark ? root.dark-card-bg : root.light-card-bg;
    in-out property <color> deep-bg: root.theme-dark ? root.dark-deep-bg : root.light-deep-bg;
    in-out property <color> nested-bg: root.theme-dark ? root.dark-nested-bg : root.light-nested-bg;
    in-out property <color> text-main: root.theme-dark ? root.dark-text-main : root.light-text-main;
    in-out property <color> text-title: root.theme-dark ? root.dark-text-title : root.light-text-title;
    in-out property <color> text-muted: root.theme-dark ? root.dark-text-muted : root.light-text-muted;
    in-out property <color> border-main: root.theme-dark ? root.dark-border-main : root.light-border-main;
    in-out property <color> green: root.theme-dark ? root.dark-green : root.light-green;
    in-out property <color> red: root.theme-dark ? root.dark-red : root.light-red;
    in-out property <color> amber: root.theme-dark ? root.dark-amber : root.light-amber;
    in-out property <color> clock-sep: root.theme-dark ? root.dark-clock-sep : root.light-clock-sep;
}

// ── Structs ─────────────────────────────────────────────────────────────────

export struct LogEntry {
    timestamp: string,
    timecode: string,
    milliseconds: string,
    note: string,
}

export struct FrameRateOption {
    name: string,
    fps: float,
    drop-frame: bool,
    description: string,
}

export struct ToastData {
    id: int,
    message: string,
    toast-type: string,
    opacity: float,
}

export struct FileGroupInfo {
    prefix: string,
    files: [string],
    channel-count: int,
}

// ── Pill box ────────────────────────────────────────────────────────────────

component PillBox {
    in-out property <string> pill-text;
    in-out property <color> bg: AppColors.nested-bg;
    in-out property <color> text-color: AppColors.text-muted;

    Rectangle {
        border-radius: 6px;
        border-width: 1px;
        border-color: AppColors.border-main;
        background: root.bg;
        min-height: 20px;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 4px;
            padding-bottom: 4px;

            Text {
                text: root.pill-text;
                color: root.text-color;
                font-weight: 600;
                font-size: 10px;
                vertical-alignment: center;
            }
        }
    }
}

// ── Clock Section ──────────────────────────────────────────────────────────

component ClockSection {
    in-out property <string> tc-hh: "01";
    in-out property <string> tc-sep1: ":";
    in-out property <string> tc-mm: "00";
    in-out property <string> tc-sep2: ":";
    in-out property <string> tc-ss: "00";
    in-out property <string> tc-sep3: ":";
    in-out property <string> tc-ff: "00";
    in-out property <string> ms-text;
    in-out property <bool> is-playing;
    in-out property <bool> is-locked;
    in-out property <string> fps-name;
    in-out property <string> ltc-route;
    in-out property <string> beep-route;
    in-out property <float> pulse-phase: 0.0;
    in-out property <length> window-width: 800px;
    callback start-ltc;
    callback stop-ltc;
    callback clap-beep;
    callback reset-tc;
    callback toggle-lock;

    Rectangle {
        border-radius: 16px;
        border-width: 1.5px;
        border-color: AppColors.border-main;
        background: AppColors.card-bg;

        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 8px;

            // Header: "LINEAR TIMECODE STREAM" + pulsing dot
            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                Text {
                    text: "LINEAR TIMECODE STREAM";
                    color: AppColors.accent;
                    font-size: 10px;
                    font-weight: 700;
                }
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.is-playing ? AppColors.green : AppColors.amber;
                    opacity: root.is-playing ? Math.sin(root.pulse-phase * 1rad) * 0.3 + 0.7 : 1.0;
                }
            }

            // Large timecode digits (individual segments with colored separators)
            HorizontalLayout {
                alignment: center;
                spacing: 0px;
                Text { text: root.tc-hh; color: AppColors.text-main; font-size: 48px; font-weight: 700; }
                Text { text: root.tc-sep1; color: AppColors.clock-sep; font-size: 48px; font-weight: 700; }
                Text { text: root.tc-mm; color: AppColors.text-main; font-size: 48px; font-weight: 700; }
                Text { text: root.tc-sep2; color: AppColors.clock-sep; font-size: 48px; font-weight: 700; }
                Text { text: root.tc-ss; color: AppColors.text-main; font-size: 48px; font-weight: 700; }
                Text { text: root.tc-sep3; color: AppColors.accent; font-size: 48px; font-weight: 700; }
                Text { text: root.tc-ff; color: AppColors.accent; font-size: 48px; font-weight: 700; }
            }

            // Millisecond display
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                Text {
                    text: "MS MATCH:";
                    color: AppColors.text-muted;
                    font-size: 10px;
                    font-weight: 700;
                }
                Text {
                    text: root.ms-text;
                    color: AppColors.text-title;
                    font-size: 10px;
                    font-weight: 700;
                }
            }

            // FPS and Routing pills
            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                PillBox {
                    pill-text: "⚡ FPS: " + root.fps-name;
                }
                PillBox {
                    pill-text: "🔊 ROUTE: LTC " + root.ltc-route + " | CLAP " + root.beep-route;
                }
            }

            // Buttons row (responsive: horizontal when >= 420px)
            if root.window-width >= 420px : HorizontalLayout {
                spacing: 8px;
                alignment: center;

                if (root.is-playing) : Rectangle {
                    min-width: 160px;
                    border-radius: 8px;
                    background: AppColors.red;
                    min-height: 40px;
                    TouchArea {
                        enabled: !root.is-locked;
                        clicked => { root.stop-ltc(); }
                    }
                    Text {
                        text: "■ STOP";
                        color: white;
                        font-weight: 700;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if (!root.is-playing) : Rectangle {
                    min-width: 160px;
                    border-radius: 8px;
                    background: AppColors.nested-bg;
                    border-width: 1px;
                    border-color: AppColors.border-main;
                    min-height: 40px;
                    TouchArea {
                        enabled: !root.is-locked;
                        clicked => { root.start-ltc(); }
                    }
                    Text {
                        text: "▶ START";
                        color: AppColors.text-title;
                        font-weight: 700;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Clap & Beep accent button
                Rectangle {
                    min-width: 140px;
                    min-height: 40px;
                    border-radius: 8px;
                    background: AppColors.accent;
                    TouchArea {
                        enabled: !root.is-locked;
                        clicked => { root.clap-beep(); }
                    }
                    Text {
                        text: "🎥 CLAP & BEEP";
                        color: black;
                        font-weight: 700;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Reset button
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 8px;
                    background: AppColors.nested-bg;
                    border-width: 1px;
                    border-color: AppColors.border-main;
                    TouchArea {
                        enabled: !root.is-locked;
                        clicked => { root.reset-tc(); }
                    }
                    Text {
                        text: "⟲";
                        color: AppColors.text-title;
                        font-weight: 700;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Lock button
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 8px;
                    background: root.is-locked ? AppColors.accent : AppColors.nested-bg;
                    border-width: 1px;
                    border-color: root.is-locked ? AppColors.accent : AppColors.border-main;
                    TouchArea {
                        clicked => { root.toggle-lock(); }
                    }
                    Text {
                        text: root.is-locked ? "🔒" : "🔓";
                        color: root.is-locked ? black : AppColors.text-muted;
                        font-weight: 700;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Narrow buttons layout (< 420px)
            if root.window-width < 420px : VerticalLayout {
                spacing: 8px;
                alignment: center;

                if (root.is-playing) : Rectangle {
                    border-radius: 8px;
                    background: AppColors.red;
                    min-height: 40px;
                    min-width: 200px;
                    TouchArea {
                        enabled: !root.is-locked;
                        clicked => { root.stop-ltc(); }
                    }
                    Text {
                        text: "■ STOP";
                        color: white;
                        font-weight: 700;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if (!root.is-playing) : Rectangle {
                    border-radius: 8px;
                    background: AppColors.nested-bg;
                    border-width: 1px;
                    border-color: AppColors.border-main;
                    min-height: 40px;
                    min-width: 200px;
                    TouchArea {
                        enabled: !root.is-locked;
                        clicked => { root.start-ltc(); }
                    }
                    Text {
                        text: "▶ START";
                        color: AppColors.text-title;
                        font-weight: 700;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Clap & Beep
                Rectangle {
                    min-height: 40px;
                    min-width: 200px;
                    border-radius: 8px;
                    background: AppColors.accent;
                    TouchArea {
                        enabled: !root.is-locked;
                        clicked => { root.clap-beep(); }
                    }
                    Text {
                        text: "🎥 CLAP & BEEP";
                        color: black;
                        font-weight: 700;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Reset + Lock row
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 8px;
                        background: AppColors.nested-bg;
                        border-width: 1px;
                        border-color: AppColors.border-main;
                        TouchArea {
                            enabled: !root.is-locked;
                            clicked => { root.reset-tc(); }
                        }
                        Text {
                            text: "⟲";
                            color: AppColors.text-title;
                            font-weight: 700;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 8px;
                        background: root.is-locked ? AppColors.accent : AppColors.nested-bg;
                        border-width: 1px;
                        border-color: root.is-locked ? AppColors.accent : AppColors.border-main;
                        TouchArea {
                            clicked => { root.toggle-lock(); }
                        }
                        Text {
                            text: root.is-locked ? "🔒" : "🔓";
                            color: root.is-locked ? black : AppColors.text-muted;
                            font-weight: 700;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// ── Clapper Section ────────────────────────────────────────────────────────

component ClapperSection {
    in-out property <int> scene;
    in-out property <int> take;
    in-out property <string> roll;
    in-out property <bool> auto-increment;
    in-out property <[LogEntry]> logs;
    in-out property <float> arm-angle: -0.43633;
    in-out property <length> window-width: 800px;
    in-out property <bool> copy-confirmed: false;

    callback scene-up;
    callback scene-down;
    callback take-up;
    callback take-down;
    callback roll-changed;
    callback auto-increment-toggled;
    callback clap-beep;
    callback clear-logs;
    callback copy-logs;

    if root.window-width >= 600px : HorizontalLayout {
        spacing: 12px;

        // Left column: board + cards + auto-increment + clap button
        VerticalLayout {
            spacing: 12px;

            // Clapper board drawing
            Rectangle {
                vertical-stretch: 0;
                min-height: 100px;
                background: AppColors.deep-bg;
                border-radius: 8px;
                border-width: 1px;
                border-color: AppColors.border-main;

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 4px;
                    alignment: center;

                    // Top bar (static hinge / fixed board)
                    Rectangle {
                        height: 20px;
                        background: AppColors.deep-bg;
                        border-width: 1px;
                        border-color: AppColors.border-main;
                        border-radius: 2px;
                        HorizontalLayout {
                            spacing: 0px;
                            for stripe-index in [0, 1, 2, 3, 4, 5] : Rectangle {
                                width: 1px;
                                background: Math.mod(stripe-index, 2) == 0 ? AppColors.deep-bg : AppColors.accent;
                                border-radius: 0px;
                            }
                        }
                    }

                    // Hinge gap
                    Rectangle {
                        height: 2px;
                        background: AppColors.border-main;
                    }

                    // Bottom arm (vertical bounce on clap)
                    Rectangle {
                        height: 22px;
                        Rectangle {
                            height: 20px;
                            y: 2px + root.arm-angle * 1px;
                            background: AppColors.deep-bg;
                            border-width: 1px;
                            border-color: AppColors.border-main;
                            border-radius: 2px;
                            HorizontalLayout {
                                spacing: 0px;
                                for stripe-index in [0, 1, 2, 3, 4, 5] : Rectangle {
                                    width: 1px;
                                    background: Math.mod(stripe-index, 2) == 0 ? AppColors.deep-bg : AppColors.accent;
                                    border-radius: 0px;
                                }
                            }
                        }
                    }

                    Text {
                        text: "Tap to clap";
                        color: AppColors.text-muted;
                        font-size: 12px;
                    }
                }

                TouchArea {
                    clicked => { root.clap-beep(); }
                }
            }

            // Roll, Scene, Take cards
            HorizontalLayout {
                spacing: 8px;

                // Roll card
                Rectangle {
                    border-radius: 8px;
                    background: AppColors.nested-bg;
                    border-width: 1px;
                    border-color: AppColors.border-main;
                    min-height: 70px;
                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "ROLL";
                            color: AppColors.text-muted;
                            font-size: 9px;
                            font-weight: 700;
                        }
                        TextInput {
                            text: root.roll;
                            font-size: 14px;
                            color: AppColors.text-title;
                            font-weight: 700;
                            horizontal-alignment: center;
                            edited => { root.roll-changed(); }
                        }
                    }
                }

                // Scene card
                Rectangle {
                    border-radius: 8px;
                    background: AppColors.nested-bg;
                    border-width: 1px;
                    border-color: AppColors.border-main;
                    min-height: 70px;
                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "SCENE";
                            color: AppColors.text-muted;
                            font-size: 9px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.scene;
                            color: AppColors.text-title;
                            font-size: 18px;
                            font-weight: 700;
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: center;
                            Rectangle {
                                width: 22px; height: 22px;
                                border-radius: 4px;
                                background: AppColors.card-bg;
                                border-width: 1px;
                                border-color: AppColors.border-main;
                                TouchArea { clicked => { root.scene-down(); } }
                                Text { text: "-"; color: AppColors.text-title; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                width: 22px; height: 22px;
                                border-radius: 4px;
                                background: AppColors.card-bg;
                                border-width: 1px;
                                border-color: AppColors.border-main;
                                TouchArea { clicked => { root.scene-up(); } }
                                Text { text: "+"; color: AppColors.text-title; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }

                // Take card
                Rectangle {
                    border-radius: 8px;
                    background: AppColors.nested-bg;
                    border-width: 1px;
                    border-color: AppColors.border-main;
                    min-height: 70px;
                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "TAKE";
                            color: AppColors.text-muted;
                            font-size: 9px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.take;
                            color: AppColors.accent;
                            font-size: 18px;
                            font-weight: 700;
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: center;
                            Rectangle {
                                width: 22px; height: 22px;
                                border-radius: 4px;
                                background: AppColors.card-bg;
                                border-width: 1px;
                                border-color: AppColors.border-main;
                                TouchArea { clicked => { root.take-down(); } }
                                Text { text: "-"; color: AppColors.text-title; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                width: 22px; height: 22px;
                                border-radius: 4px;
                                background: AppColors.card-bg;
                                border-width: 1px;
                                border-color: AppColors.border-main;
                                TouchArea { clicked => { root.take-up(); } }
                                Text { text: "+"; color: AppColors.text-title; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            // Auto-increment checkbox
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "Auto-Increment Take";
                    color: AppColors.text-muted;
                    font-size: 11px;
                }
                TouchArea {
                    clicked => { root.auto-increment-toggled(); }
                    Rectangle {
                        width: 16px; height: 16px;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: AppColors.border-main;
                        background: root.auto-increment ? AppColors.accent : AppColors.nested-bg;
                        if (root.auto-increment) : Text {
                            text: "✓";
                            color: black;
                            font-weight: 700;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Clap & Beep button
            Rectangle {
                min-height: 44px;
                border-radius: 8px;
                background: AppColors.accent;
                TouchArea {
                    clicked => { root.clap-beep(); }
                }
                Text {
                    text: "CLAP & BEEP";
                    color: black;
                    font-weight: 700;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Spacer to absorb remaining vertical space
            Rectangle { vertical-stretch: 1; background: transparent; }
        }

        // Right column: logs
        Rectangle {
            border-radius: 8px;
            background: AppColors.card-bg;
            border-width: 1.5px;
            border-color: AppColors.border-main;

            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;

                // Logs header
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "📋 SYNCHRONIZATION LOGS";
                        color: AppColors.text-muted;
                        font-size: 11px;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 4px;
                        Rectangle {
                            min-width: 50px; min-height: 24px;
                            border-radius: 4px;
                            background: root.copy-confirmed ? AppColors.green : AppColors.nested-bg;
                            border-width: 1px;
                            border-color: root.copy-confirmed ? AppColors.green : AppColors.border-main;
                            TouchArea { clicked => { root.copy-logs(); } }
                            Text {
                                text: root.copy-confirmed ? "✓" : "Copy";
                                color: root.copy-confirmed ? white : AppColors.text-title;
                                font-size: 10px; font-weight: 600;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            min-width: 50px; min-height: 24px;
                            border-radius: 4px;
                            background: AppColors.nested-bg;
                            border-width: 1px;
                            border-color: AppColors.border-main;
                            TouchArea { clicked => { root.clear-logs(); } }
                            Text { text: "Clear"; color: AppColors.text-title; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                // Log entries list (stretches to fill remaining height)
                if (root.logs.length == 0) : VerticalLayout {
                    vertical-stretch: 0;
                    spacing: 4px;
                    alignment: center;
                    padding-top: 20px;
                    padding-bottom: 20px;
                    Text { text: "No clapper marks recorded yet."; color: AppColors.text-muted; font-weight: 700; }
                    Text { text: "Tap CLAP & BEEP to capture markings."; color: AppColors.text-muted; font-size: 10px; }
                }
                if (root.logs.length == 0) : Rectangle { vertical-stretch: 1; background: transparent; }
                if (root.logs.length > 0) : ListView {
                    for log-entry in root.logs : Rectangle {
                        border-radius: 6px;
                        background: AppColors.nested-bg;
                        border-width: 1px;
                        border-color: AppColors.border-main;
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 4px;
                            HorizontalLayout {
                                Text { text: log-entry.note; color: AppColors.accent; font-weight: 700; font-size: 12px; }
                                HorizontalLayout { alignment: end; Text { text: log-entry.timestamp; color: AppColors.text-muted; font-size: 10px; } }
                            }
                            HorizontalLayout {
                                Text { text: "LTC Timecode:"; color: AppColors.text-muted; font-size: 10.5px; }
                                Text { text: log-entry.timecode; color: AppColors.text-title; font-weight: 700; font-size: 10.5px; horizontal-alignment: right; }
                            }
                            HorizontalLayout {
                                Text { text: "Milliseconds:"; color: AppColors.text-muted; font-size: 10.5px; }
                                Text { text: log-entry.milliseconds; color: AppColors.accent; font-weight: 700; font-size: 10.5px; horizontal-alignment: right; }
                            }
                        }
                    }
                }
            }
        }
    }

    // Narrow layout (< 600px) — single column
    if root.window-width < 600px : VerticalLayout {
        spacing: 12px;

        // Clapper board drawing
        Rectangle {
            vertical-stretch: 0;
            min-height: 100px;
            background: AppColors.deep-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppColors.border-main;

            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 4px;
                alignment: center;

                // Top bar (static hinge / fixed board)
                Rectangle {
                    height: 20px;
                    background: AppColors.deep-bg;
                    border-width: 1px;
                    border-color: AppColors.border-main;
                    border-radius: 2px;
                    HorizontalLayout {
                        spacing: 0px;
                        for stripe-index in [0, 1, 2, 3, 4, 5] : Rectangle {
                            width: 1px;
                            background: Math.mod(stripe-index, 2) == 0 ? AppColors.deep-bg : AppColors.accent;
                            border-radius: 0px;
                        }
                    }
                }

                // Hinge gap
                Rectangle {
                    height: 2px;
                    background: AppColors.border-main;
                }

                // Bottom arm (vertical bounce on clap)
                Rectangle {
                    height: 22px;
                    Rectangle {
                        height: 20px;
                        y: 2px + root.arm-angle * 1px;
                        background: AppColors.deep-bg;
                        border-width: 1px;
                        border-color: AppColors.border-main;
                        border-radius: 2px;
                        HorizontalLayout {
                            spacing: 0px;
                            for stripe-index in [0, 1, 2, 3, 4, 5] : Rectangle {
                                width: 1px;
                                background: Math.mod(stripe-index, 2) == 0 ? AppColors.deep-bg : AppColors.accent;
                                border-radius: 0px;
                            }
                        }
                    }
                }

                Text {
                    text: "Tap to clap";
                    color: AppColors.text-muted;
                    font-size: 12px;
                }
            }

            TouchArea {
                clicked => { root.clap-beep(); }
            }
        }

        // Roll, Scene, Take cards
        HorizontalLayout {
            spacing: 8px;

            // Roll card
            Rectangle {
                border-radius: 8px;
                background: AppColors.nested-bg;
                border-width: 1px;
                border-color: AppColors.border-main;
                min-height: 70px;
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: "ROLL";
                        color: AppColors.text-muted;
                        font-size: 9px;
                        font-weight: 700;
                    }
                    TextInput {
                        text: root.roll;
                        font-size: 14px;
                        color: AppColors.text-title;
                        font-weight: 700;
                        horizontal-alignment: center;
                        edited => { root.roll-changed(); }
                    }
                }
            }

            // Scene card
            Rectangle {
                border-radius: 8px;
                background: AppColors.nested-bg;
                border-width: 1px;
                border-color: AppColors.border-main;
                min-height: 70px;
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: "SCENE";
                        color: AppColors.text-muted;
                        font-size: 9px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.scene;
                        color: AppColors.text-title;
                        font-size: 18px;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        Rectangle {
                            width: 22px; height: 22px;
                            border-radius: 4px;
                            background: AppColors.card-bg;
                            border-width: 1px;
                            border-color: AppColors.border-main;
                            TouchArea { clicked => { root.scene-down(); } }
                            Text { text: "-"; color: AppColors.text-title; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 22px; height: 22px;
                            border-radius: 4px;
                            background: AppColors.card-bg;
                            border-width: 1px;
                            border-color: AppColors.border-main;
                            TouchArea { clicked => { root.scene-up(); } }
                            Text { text: "+"; color: AppColors.text-title; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }

            // Take card
            Rectangle {
                border-radius: 8px;
                background: AppColors.nested-bg;
                border-width: 1px;
                border-color: AppColors.border-main;
                min-height: 70px;
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: "TAKE";
                        color: AppColors.text-muted;
                        font-size: 9px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.take;
                        color: AppColors.accent;
                        font-size: 18px;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        Rectangle {
                            width: 22px; height: 22px;
                            border-radius: 4px;
                            background: AppColors.card-bg;
                            border-width: 1px;
                            border-color: AppColors.border-main;
                            TouchArea { clicked => { root.take-down(); } }
                            Text { text: "-"; color: AppColors.text-title; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 22px; height: 22px;
                            border-radius: 4px;
                            background: AppColors.card-bg;
                            border-width: 1px;
                            border-color: AppColors.border-main;
                            TouchArea { clicked => { root.take-up(); } }
                            Text { text: "+"; color: AppColors.text-title; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // Auto-increment checkbox
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "Auto-Increment Take";
                color: AppColors.text-muted;
                font-size: 11px;
            }
            TouchArea {
                clicked => { root.auto-increment-toggled(); }
                Rectangle {
                    width: 16px; height: 16px;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: AppColors.border-main;
                    background: root.auto-increment ? AppColors.accent : AppColors.nested-bg;
                    if (root.auto-increment) : Text {
                        text: "✓";
                        color: black;
                        font-weight: 700;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Clap & Beep button
        Rectangle {
            min-height: 44px;
            border-radius: 8px;
            background: AppColors.accent;
            TouchArea {
                clicked => { root.clap-beep(); }
            }
            Text {
                text: "CLAP & BEEP";
                color: black;
                font-weight: 700;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Spacer to absorb remaining vertical space
        Rectangle { vertical-stretch: 1; background: transparent; }

        // Logs section
        Rectangle {
            border-radius: 8px;
            background: AppColors.card-bg;
            border-width: 1.5px;
            border-color: AppColors.border-main;

            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;

                // Logs header
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "📋 SYNCHRONIZATION LOGS";
                        color: AppColors.text-muted;
                        font-size: 11px;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 4px;
                        Rectangle {
                            min-width: 50px; min-height: 24px;
                            border-radius: 4px;
                            background: root.copy-confirmed ? AppColors.green : AppColors.nested-bg;
                            border-width: 1px;
                            border-color: root.copy-confirmed ? AppColors.green : AppColors.border-main;
                            TouchArea { clicked => { root.copy-logs(); } }
                            Text {
                                text: root.copy-confirmed ? "✓" : "Copy";
                                color: root.copy-confirmed ? white : AppColors.text-title;
                                font-size: 10px; font-weight: 600;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            min-width: 50px; min-height: 24px;
                            border-radius: 4px;
                            background: AppColors.nested-bg;
                            border-width: 1px;
                            border-color: AppColors.border-main;
                            TouchArea { clicked => { root.clear-logs(); } }
                            Text { text: "Clear"; color: AppColors.text-title; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                // Log entries list
                if (root.logs.length == 0) : VerticalLayout {
                    vertical-stretch: 0;
                    spacing: 4px;
                    alignment: center;
                    padding-top: 20px;
                    padding-bottom: 20px;
                    Text { text: "No clapper marks recorded yet."; color: AppColors.text-muted; font-weight: 700; }
                    Text { text: "Tap CLAP & BEEP to capture markings."; color: AppColors.text-muted; font-size: 10px; }
                }
                if (root.logs.length == 0) : Rectangle { vertical-stretch: 1; background: transparent; }
                if (root.logs.length > 0) : ListView {
                    for log-entry in root.logs : Rectangle {
                        border-radius: 6px;
                        background: AppColors.nested-bg;
                        border-width: 1px;
                        border-color: AppColors.border-main;
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 4px;
                            HorizontalLayout {
                                Text { text: log-entry.note; color: AppColors.accent; font-weight: 700; font-size: 12px; }
                                HorizontalLayout { alignment: end; Text { text: log-entry.timestamp; color: AppColors.text-muted; font-size: 10px; } }
                            }
                            HorizontalLayout {
                                Text { text: "LTC Timecode:"; color: AppColors.text-muted; font-size: 10.5px; }
                                Text { text: log-entry.timecode; color: AppColors.text-title; font-weight: 700; font-size: 10.5px; horizontal-alignment: right; }
                            }
                            HorizontalLayout {
                                Text { text: "Milliseconds:"; color: AppColors.text-muted; font-size: 10.5px; }
                                Text { text: log-entry.milliseconds; color: AppColors.accent; font-weight: 700; font-size: 10.5px; horizontal-alignment: right; }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ── Stepper card ────────────────────────────────────────────────────────────

component StepperCard {
    in-out property <string> label;
    in-out property <int> value;
    in-out property <bool> enabled: true;
    callback up;
    callback down;

    Rectangle {
        border-radius: 8px;
        background: AppColors.deep-bg;
        border-width: 1px;
        border-color: AppColors.border-main;

        VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 2px;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 24px; height: 20px;
                    border-radius: 4px;
                    background: AppColors.nested-bg;
                    border-width: 1px;
                    border-color: AppColors.border-main;
                    TouchArea {
                        enabled: root.enabled;
                        clicked => { root.up(); }
                    }
                    Text { text: "^"; color: AppColors.text-title; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            Text {
                text: root.value;
                color: AppColors.text-title;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: root.label;
                color: AppColors.text-muted;
                font-size: 7.5px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 24px; height: 20px;
                    border-radius: 4px;
                    background: AppColors.nested-bg;
                    border-width: 1px;
                    border-color: AppColors.border-main;
                    TouchArea {
                        enabled: root.enabled;
                        clicked => { root.down(); }
                    }
                    Text { text: "v"; color: AppColors.text-title; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}

// ── Settings Section ───────────────────────────────────────────────────────

component SettingsSection {
    in-out property <int> hour;
    in-out property <int> minute;
    in-out property <int> second;
    in-out property <int> frame;
    in-out property <int> max-frame;
    in-out property <int> fps-index;
    in-out property <[FrameRateOption]> fps-options;
    in-out property <int> sample-rate-index;
    in-out property <[string]> sample-rate-options;
    in-out property <int> device-index;
    in-out property <[string]> device-names;
    in-out property <int> ltc-channel-index;
    in-out property <int> beep-channel-index;
    in-out property <float> ltc-volume;
    in-out property <float> beep-volume;
    in-out property <float> beep-frequency;
    in-out property <float> beep-duration;
    in-out property <bool> settings-enabled;
    in-out property <length> window-width: 800px;

    callback hour-up;
    callback hour-down;
    callback minute-up;
    callback minute-down;
    callback second-up;
    callback second-down;
    callback frame-up;
    callback frame-down;
    callback fps-selected(int);
    callback sample-rate-tapped(string);
    callback device-selected(int);
    callback ltc-channel-selected(int);
    callback beep-channel-selected(int);
    callback ltc-volume-changed(float);
    callback beep-volume-changed(float);
    callback beep-frequency-changed(float);
    callback beep-duration-changed(float);
    callback refresh-devices;

    Rectangle {
        border-radius: 12px;
        border-width: 1.5px;
        border-color: AppColors.border-main;
        background: AppColors.card-bg;

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 16px;

            // 1. Start Timecode Steppers
            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    Text {
                        text: "⚙️ SET STARTING TIMECODE";
                        color: AppColors.text-muted;
                        font-size: 11px;
                        font-weight: 700;
                    }
                    if (!root.settings-enabled) : Rectangle {
                        border-radius: 6px;
                        background: #F59E0B1A;
                        border-width: 1px;
                        border-color: #F59E0B33;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            Text {
                                text: "STOP STREAM TO EDIT";
                                color: AppColors.amber;
                                font-weight: 700;
                                font-size: 9px;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    StepperCard { label: "HOURS"; value: root.hour; enabled: root.settings-enabled; up => { root.hour-up(); } down => { root.hour-down(); } }
                    StepperCard { label: "MINUTES"; value: root.minute; enabled: root.settings-enabled; up => { root.minute-up(); } down => { root.minute-down(); } }
                    StepperCard { label: "SECONDS"; value: root.second; enabled: root.settings-enabled; up => { root.second-up(); } down => { root.second-down(); } }
                    StepperCard { label: "FRAMES"; value: root.frame; enabled: root.settings-enabled; up => { root.frame-up(); } down => { root.frame-down(); } }
                }
            }

            // 2. Frame Rate
            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "📈 SELECT FRAME RATE";
                    color: AppColors.text-muted;
                    font-size: 11px;
                    font-weight: 700;
                }
                HorizontalLayout {
                    spacing: 6px;
                    for fps-item in root.fps-options : Rectangle {
                        min-width: 90px;
                        min-height: 60px;
                        border-radius: 8px;
                        background: fps-item == root.fps-options[root.fps-index] ? AppColors.accent : AppColors.nested-bg;
                        border-width: fps-item == root.fps-options[root.fps-index] ? 0px : 1px;
                        border-color: AppColors.border-main;
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 2px;
                            Text {
                                text: fps-item.name;
                                color: fps-item == root.fps-options[root.fps-index] ? black : AppColors.text-title;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            Text {
                                text: fps-item.description;
                                color: fps-item == root.fps-options[root.fps-index] ? black : AppColors.text-muted;
                                font-size: 9px;
                            }
                        }
                        TouchArea {
                            enabled: root.settings-enabled;
                            clicked => { root.fps-selected(fps-item.fps * 100); }
                        }
                    }
                }
            }

            // 3. Sample Rate
            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "🎛️ SAMPLE RATE";
                    color: AppColors.text-muted;
                    font-size: 11px;
                    font-weight: 700;
                }
                HorizontalLayout {
                    spacing: 6px;
                    for rate-text in root.sample-rate-options : Rectangle {
                        min-width: 100px;
                        min-height: 36px;
                        border-radius: 8px;
                        background: rate-text == root.sample-rate-options[root.sample-rate-index] ? AppColors.accent : AppColors.card-bg;
                        border-width: rate-text == root.sample-rate-options[root.sample-rate-index] ? 0px : 1px;
                        border-color: AppColors.border-main;
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            alignment: center;
                            Text {
                                text: rate-text;
                                color: rate-text == root.sample-rate-options[root.sample-rate-index] ? black : AppColors.text-title;
                                font-weight: 700;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            enabled: root.settings-enabled;
                            clicked => { root.sample-rate-tapped(rate-text); }
                        }
                    }
                }
            }

            // 4. Audio Device
            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "🔊 OUTPUT AUDIO INTERFACE";
                    color: AppColors.text-muted;
                    font-size: 11px;
                    font-weight: 700;
                }
                Rectangle {
                    border-radius: 10px;
                    background: AppColors.deep-bg;
                    border-width: 1px;
                    border-color: AppColors.border-main;
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "Interface:";
                                color: AppColors.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            if (root.device-names.length > 0) : ComboBox {
                                current-index: root.device-index;
                                model: root.device-names;
                                selected => {
                                    root.device-selected(self.current-index);
                                }
                            }
                            if (root.device-names.length == 0) : Text {
                                text: "No devices found — using default output";
                                color: AppColors.text-muted;
                                font-size: 12px;
                            }
                            Rectangle {
                                min-width: 80px; min-height: 28px;
                                border-radius: 6px;
                                background: AppColors.card-bg;
                                border-width: 1px;
                                border-color: AppColors.border-main;
                                TouchArea { clicked => { root.refresh-devices(); } }
                                Text {
                                    text: "Refresh List";
                                    color: AppColors.text-muted;
                                    font-size: 10px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle {
                            border-radius: 6px;
                            background: AppColors.card-bg;
                            border-width: 1px;
                            border-color: AppColors.border-main;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 6px;
                                Rectangle {
                                    width: 6px; height: 6px;
                                    border-radius: 3px;
                                    background: AppColors.accent;
                                }
                                Text {
                                    text: "Sends SMPTE Linear Timecode audio directly to mixers, USB-DAC, or sync adapters.";
                                    color: AppColors.text-muted;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }

            // 5. Routing & Volume
            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "🎛️ AUDIO ROUTING & SETTINGS (DUAL-CHANNEL SPLITS)";
                    color: AppColors.text-muted;
                    font-size: 11px;
                    font-weight: 700;
                }
                Rectangle {
                    border-radius: 10px;
                    background: AppColors.deep-bg;
                    border-width: 1px;
                    border-color: AppColors.border-main;

                    // 2-col routing+sliders
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 20px;

                        // Left column: routing
                        VerticalLayout {
                            spacing: 10px;
                            // LTC routing
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: "LTC OUTPUT";
                                    color: AppColors.text-muted;
                                    font-size: 9px;
                                    font-weight: 700;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    for ch-index in [0, 1, 2] : Rectangle {
                                        min-width: 60px; min-height: 28px;
                                        border-radius: 6px;
                                        background: root.ltc-channel-index == ch-index ? AppColors.accent : AppColors.card-bg;
                                        border-width: root.ltc-channel-index == ch-index ? 0px : 1px;
                                        border-color: AppColors.border-main;
                                        TouchArea {
                                            clicked => { root.ltc-channel-selected(ch-index); }
                                        }
                                        Text {
                                            text: ch-index == 0 ? "Left" : (ch-index == 1 ? "Right" : "Both");
                                            color: root.ltc-channel-index == ch-index ? black : AppColors.text-title;
                                            font-weight: 700;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Beep routing
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: "CLAPPER OUTPUT";
                                    color: AppColors.text-muted;
                                    font-size: 9px;
                                    font-weight: 700;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    for ch-index in [0, 1, 2] : Rectangle {
                                        min-width: 60px; min-height: 28px;
                                        border-radius: 6px;
                                        background: root.beep-channel-index == ch-index ? AppColors.accent : AppColors.card-bg;
                                        border-width: root.beep-channel-index == ch-index ? 0px : 1px;
                                        border-color: AppColors.border-main;
                                        TouchArea {
                                            clicked => { root.beep-channel-selected(ch-index); }
                                        }
                                        Text {
                                            text: ch-index == 0 ? "Left" : (ch-index == 1 ? "Right" : "Both");
                                            color: root.beep-channel-index == ch-index ? black : AppColors.text-title;
                                            font-weight: 700;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Right column: sliders
                        VerticalLayout {
                            spacing: 6px;
                            GridLayout {
                            spacing: 6px;
                            Row {
                                Text { text: "LTC VOL"; color: AppColors.text-muted; font-size: 9px; font-weight: 700; }
                                Slider {
                                    value: root.ltc-volume;
                                    minimum: 0.0; maximum: 1.0;
                                    changed(new_val) => { root.ltc-volume-changed(new_val); }
                                }
                                Text {
                                    text: root.ltc-volume * 100;
                                    color: AppColors.text-title;
                                    font-size: 10px;
                                    font-weight: 700;
                                }
                            }
                            Row {
                                Text { text: "BEEP VOL"; color: AppColors.text-muted; font-size: 9px; font-weight: 700; }
                                Slider {
                                    value: root.beep-volume;
                                    minimum: 0.0; maximum: 1.0;
                                    changed(new_val) => { root.beep-volume-changed(new_val); }
                                }
                                Text {
                                    text: root.beep-volume * 100;
                                    color: AppColors.text-title;
                                    font-size: 10px;
                                    font-weight: 700;
                                }
                            }
                            Row {
                                Text { text: "PITCH"; color: AppColors.text-muted; font-size: 9px; font-weight: 700; }
                                Slider {
                                    value: root.beep-frequency;
                                    minimum: 400.0; maximum: 2000.0;
                                    changed(new_val) => { root.beep-frequency-changed(new_val); }
                                }
                                Text {
                                    text: root.beep-frequency;
                                    color: AppColors.text-title;
                                    font-size: 10px;
                                    font-weight: 700;
                                }
                            }
                            Row {
                                Text { text: "DUR"; color: AppColors.text-muted; font-size: 9px; font-weight: 700; }
                                Slider {
                                    value: root.beep-duration;
                                    minimum: 0.05; maximum: 2.0;
                                    changed(new_val) => { root.beep-duration-changed(new_val); }
                                }
                                Text {
                                    text: root.beep-duration * 1000;
                                    color: AppColors.text-title;
                                    font-size: 10px;
                                    font-weight: 700;
                                }
                            }
                        }

                            }
                        }

                    }

                // Tip
                Rectangle {
                    border-radius: 6px;
                    background: AppColors.card-bg;
                    border-width: 1px;
                    border-color: AppColors.border-main;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 6px;
                        Rectangle {
                            width: 8px; height: 8px;
                            border-radius: 4px;
                            background: AppColors.accent;
                        }
                        Text {
                            text: "LTC Right, Clapper Left into camera mic — Channel 1 Resolve, Channel 2 scratch.";
                            color: AppColors.text-muted;
                            font-size: 8.5px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

// ── Status Bar ─────────────────────────────────────────────────────────────

component StatusBar {
    in-out property <string> os-name;
    in-out property <int> device-count;
    in-out property <bool> is-playing;
    in-out property <string> sample-format;
    in-out property <bool> wake-lock-active;
    in-out property <string> status-message;
    in-out property <string> power-status;

    Rectangle {
        background: AppColors.deep-bg;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 16px;
            HorizontalLayout {
                spacing: 4px;
                Rectangle {
                    width: 6px; height: 6px;
                    border-radius: 3px;
                    background: AppColors.green;
                }
                Text {
                    text: "OS: " + root.os-name;
                    color: AppColors.text-title;
                    font-size: 10px;
                    font-weight: 700;
                }
            }
            HorizontalLayout {
                spacing: 4px;
                Rectangle {
                    width: 6px; height: 6px;
                    border-radius: 3px;
                    background: AppColors.green;
                }
                Text {
                    text: "AUDIO OUT: " + root.device-count + " DEVICES FOUND";
                    color: AppColors.text-title;
                    font-size: 10px;
                    font-weight: 700;
                }
            }
            HorizontalLayout {
                spacing: 4px;
                Rectangle {
                    width: 6px; height: 6px;
                    border-radius: 3px;
                    background: root.is-playing ? AppColors.green : AppColors.amber;
                }
                Text {
                    text: root.is-playing ? "AUDIO CORE: RUNNING" : "AUDIO CORE: STANDBY";
                    color: AppColors.text-title;
                    font-size: 10px;
                    font-weight: 700;
                }
            }
            if (root.sample-format != "") : HorizontalLayout {
                spacing: 4px;
                Rectangle {
                    width: 6px; height: 6px;
                    border-radius: 3px;
                    background: AppColors.green;
                }
                Text {
                    text: "SAMPLE: " + root.sample-format;
                    color: AppColors.text-title;
                    font-size: 10px;
                    font-weight: 700;
                }
            }
            HorizontalLayout {
                spacing: 4px;
                Rectangle {
                    width: 6px; height: 6px;
                    border-radius: 3px;
                    background: root.wake-lock-active ? AppColors.green : AppColors.text-muted;
                }
                Text {
                    text: root.wake-lock-active ? "WAKE LOCK: ACTIVE" : "WAKE LOCK: STANDBY";
                    color: AppColors.text-title;
                    font-size: 10px;
                    font-weight: 700;
                }
            }
            HorizontalLayout {
                spacing: 4px;
                Rectangle {
                    width: 6px; height: 6px;
                    border-radius: 3px;
                    background: AppColors.green;
                }
                Text {
                    text: "POWER: " + root.power-status;
                    color: AppColors.text-title;
                    font-size: 10px;
                    font-weight: 700;
                }
            }
            HorizontalLayout {
                alignment: end;
                Text {
                    text: root.status-message;
                    color: AppColors.text-muted;
                    font-size: 10px;
                    font-weight: 600;
                }
            }
        }
    }
}

// ── Converter Section (File Converter & Export) ───────────────────────────

component ConverterSection {
    in-out property <bool> has-ffmpeg: false;
    in-out property <string> ffmpeg-error: "";
    in-out property <string> selected-folder: "";
    in-out property <[FileGroupInfo]> file-groups: [];
    in-out property <int> selected-group-idx: -1;
    in-out property <int> num-channels: 0;
    in-out property <[int]> channel-map: [];
    in-out property <string> container: "mkv";
    in-out property <string> video-encoder: "libsvtav1";
    in-out property <string> audio-encoder: "pcm_s24le";
    in-out property <string> output-path: "";
    in-out property <string> conv-status: "idle";
    in-out property <float> conv-progress: 0.0;
    in-out property <string> conv-log: "";
    in-out property <string> sanity-msg: "";

    callback select-folder;
    callback select-group(int);
    callback map-cell-clicked(int, int);
    callback start-convert;
    callback cancel-convert;
    callback copy-log;
    callback reset-conv;

    Rectangle {
        border-radius: 12px;
        border-width: 1.5px;
        border-color: AppColors.border-main;
        background: AppColors.card-bg;

        ScrollView {
            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // ── Step 1: Select Files ──
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        width: 22px; height: 22px; border-radius: 4px;
                        background: AppColors.accent;
                        Text { text: "1"; color: black; font-size: 11px; font-weight: 700;
                               horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "SELECT FILES"; color: AppColors.text-title; font-size: 12px; font-weight: 700; }
                }

                HorizontalLayout { spacing: 6px;
                    Text { text: "Naming pattern:"; color: AppColors.text-muted; font-size: 10px; font-weight: 600; }
                    Text { text: "TASCAM"; color: AppColors.text-title; font-size: 11px; font-family: "monospace"; font-weight: 700; }
                }

                Rectangle {
                    border-radius: 8px;
                    background: AppColors.deep-bg;
                    border-width: 1px; border-color: AppColors.border-main;
                    min-height: 32px;
                    TouchArea { clicked => { root.select-folder(); } }
                    HorizontalLayout { padding: 8px; spacing: 6px;
                        Text { text: "📂"; font-size: 12px; }
                        Text {
                            text: root.selected-folder == "" ? "Select Folder…" : root.selected-folder;
                            color: root.selected-folder == "" ? AppColors.text-muted : AppColors.text-title;
                            font-size: 10px; font-family: "monospace";
                            horizontal-stretch: 1; vertical-alignment: center;
                        }
                    }
                }

                if (root.file-groups.length > 0) : VerticalLayout { spacing: 4px;
                    Text { text: "Recording:"; color: AppColors.text-muted; font-size: 10px; font-weight: 600; }
                    for group[idx] in root.file-groups : Rectangle {
                        border-radius: 6px;
                        background: AppColors.accent;
                        opacity: root.selected-group-idx == idx ? 0.15 : 1.0;
                        border-width: 1px;
                        border-color: root.selected-group-idx == idx ? AppColors.accent : AppColors.border-main;
                        min-height: 28px;
                        TouchArea { clicked => { root.select-group(idx); } }
                        HorizontalLayout { padding: 6px; spacing: 6px;
                            Text { text: group.prefix; color: AppColors.text-title; font-size: 10px; font-family: "monospace"; font-weight: 700; }
                            Text {
                                text: "(" + group.channel-count + " ch)";
                                color: AppColors.text-muted; font-size: 9px;
                                horizontal-stretch: 1; vertical-alignment: center;
                            }
                        }
                    }
                }

                // ── Step 2: Channel Mapping ──
                if (root.num-channels > 0) : VerticalLayout { spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 22px; height: 22px; border-radius: 4px;
                            background: AppColors.accent;
                            Text { text: "2"; color: black; font-size: 11px; font-weight: 700;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "CHANNEL MAPPING"; color: AppColors.text-title; font-size: 12px; font-weight: 700; }
                    }
                    Text {
                        text: "Click a radio button to swap the input channel (row) with the channel currently mapped to the selected output (column).";
                        color: AppColors.text-muted; font-size: 9px; wrap: word-wrap;
                    }

                    // Matrix header
                    HorizontalLayout { spacing: 4px;
                        Rectangle { width: 36px; height: 20px; }
                        for col in root.num-channels : Rectangle {
                            width: 30px; height: 20px;
                            Text { text: "OUT " + (col + 1); color: AppColors.text-muted;
                                   font-size: 8px; font-weight: 600;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    // Matrix rows
                    for row in root.num-channels : HorizontalLayout { spacing: 4px;
                        Rectangle {
                            width: 36px; height: 30px;
                            Text { text: "CH " + (row + 1); color: AppColors.text-title;
                                   font-size: 9px; font-family: "monospace"; font-weight: 600;
                                   vertical-alignment: center; }
                        }
                        for col in root.num-channels : Rectangle {
                            width: 30px; height: 30px;
                            border-radius: 15px;
                            border-width: root.channel-map[row] == col ? 2.5px : 1px;
                            border-color: root.channel-map[row] == col ? AppColors.accent : AppColors.border-main;
                            background: root.channel-map[row] == col ? AppColors.accent : AppColors.deep-bg;
                            opacity: root.channel-map[row] == col ? 0.35 : 1.0;
                            TouchArea { clicked => { root.map-cell-clicked(row, col); } }
                        }
                    }
                }

                // ── Step 3: Output Format ──
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        width: 22px; height: 22px; border-radius: 4px;
                        background: AppColors.accent;
                        Text { text: "3"; color: black; font-size: 11px; font-weight: 700;
                               horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "OUTPUT FORMAT"; color: AppColors.text-title; font-size: 12px; font-weight: 700; }
                }

                // Container / Video / Audio selectors
                HorizontalLayout { spacing: 8px;
                    // Container
                    Rectangle {
                        border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                        background: AppColors.deep-bg; min-height: 28px; horizontal-stretch: 1;
                        VerticalLayout { padding: 4px; spacing: 2px;
                            Text { text: "Container"; color: AppColors.text-muted; font-size: 8px; font-weight: 600; }
                            Text { text: root.container; color: AppColors.text-title; font-size: 10px; font-family: "monospace"; font-weight: 700; }
                        }
                    }
                    // Video encoder
                    Rectangle {
                        border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                        background: AppColors.deep-bg; min-height: 28px; horizontal-stretch: 1;
                        VerticalLayout { padding: 4px; spacing: 2px;
                            Text { text: "Video"; color: AppColors.text-muted; font-size: 8px; font-weight: 600; }
                            Text { text: root.video-encoder; color: AppColors.text-title; font-size: 10px; font-family: "monospace"; font-weight: 700; }
                        }
                    }
                    // Audio encoder
                    Rectangle {
                        border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                        background: AppColors.deep-bg; min-height: 28px; horizontal-stretch: 1;
                        VerticalLayout { padding: 4px; spacing: 2px;
                            Text { text: "Audio"; color: AppColors.text-muted; font-size: 8px; font-weight: 600; }
                            Text { text: root.audio-encoder; color: AppColors.text-title; font-size: 10px; font-family: "monospace"; font-weight: 700; }
                        }
                    }
                }

                // Sanity / compatibility message
                if (root.sanity-msg != "") : Rectangle {
                    border-radius: 6px;
                    border-width: 1px; border-color: AppColors.amber;
                    min-height: 24px;
                    Rectangle {
                        border-radius: 6px;
                        background: AppColors.amber;
                        opacity: 0.15;
                        width: 100%; height: 100%;
                    }
                    HorizontalLayout { padding: 8px; spacing: 6px;
                        Text { text: "⚠"; color: AppColors.amber; font-size: 12px; }
                        Text { text: root.sanity-msg; color: AppColors.amber; font-size: 10px; wrap: word-wrap; horizontal-stretch: 1; }
                    }
                }
                if (!root.has-ffmpeg && root.ffmpeg-error != "") : Rectangle {
                    border-radius: 6px;
                    border-width: 1px; border-color: AppColors.red;
                    min-height: 24px;
                    Rectangle {
                        border-radius: 6px;
                        background: AppColors.red;
                        opacity: 0.1;
                        width: 100%; height: 100%;
                    }
                    HorizontalLayout { padding: 8px; spacing: 6px;
                        Text { text: "✗"; color: AppColors.red; font-size: 12px; }
                        Text { text: root.ffmpeg-error; color: AppColors.red; font-size: 10px; wrap: word-wrap; horizontal-stretch: 1; }
                    }
                }

                // ── Step 4: Output File ──
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        width: 22px; height: 22px; border-radius: 4px;
                        background: AppColors.accent;
                        Text { text: "4"; color: black; font-size: 11px; font-weight: 700;
                               horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "OUTPUT FILE"; color: AppColors.text-title; font-size: 12px; font-weight: 700; }
                }

                Rectangle {
                    border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                    background: AppColors.deep-bg; min-height: 28px;
                    HorizontalLayout { padding: 8px; spacing: 6px;
                        Text { text: "📁"; font-size: 12px; }
                        Text {
                            text: root.output-path == "" ? "(No output path set)" : root.output-path;
                            color: root.output-path == "" ? AppColors.text-muted : AppColors.text-title;
                            font-size: 10px; font-family: "monospace"; horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                    }
                }

                // ── Convert Button ──
                if (root.conv-status == "running") : Rectangle {
                    border-radius: 8px; background: AppColors.red; min-height: 40px;
                    TouchArea { clicked => { root.cancel-convert(); } }
                    Text { text: "■ CANCEL CONVERSION"; color: white; font-size: 13px; font-weight: 700;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                if (root.conv-status != "running") : Rectangle {
                    border-radius: 8px;
                    background: (root.has-ffmpeg && root.selected-group-idx >= 0 && root.output-path != "" && root.sanity-msg == "") ? AppColors.accent : AppColors.nested-bg;
                    min-height: 40px;
                    TouchArea {
                        enabled: root.has-ffmpeg && root.selected-group-idx >= 0 && root.output-path != "" && root.sanity-msg == "";
                        clicked => { root.start-convert(); }
                    }
                    Text { text: "CONVERT TO MULTI-AUDIO VIDEO"; color: black; font-size: 13px; font-weight: 700;
                           horizontal-alignment: center; vertical-alignment: center; }
                }

                // ── Progress / Log ──
                if (root.conv-status == "running") : VerticalLayout { spacing: 4px;
                    Text { text: "Converting…"; color: AppColors.text-title; font-size: 11px; font-weight: 700; }
                    Rectangle {
                        height: 8px; border-radius: 4px; background: AppColors.deep-bg;
                        Rectangle {
                            height: 8px; border-radius: 4px; background: AppColors.accent;
                            width: parent.width * root.conv-progress;
                        }
                    }
                    Text { text: "ffmpeg output:"; color: AppColors.text-muted; font-size: 9px; font-weight: 600; }
                    Rectangle {
                        border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                        background: #0D0D0F; min-height: 80px; max-height: 120px;
                        ScrollView {
                            Text {
                                text: root.conv-log == "" ? "(waiting for output…)" : root.conv-log;
                                color: #88CC88; font-size: 9px; font-family: "monospace";
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if (root.conv-status == "completed") : VerticalLayout { spacing: 6px;
                    Rectangle {
                        border-radius: 6px;
                        border-width: 1px; border-color: AppColors.green;
                        min-height: 40px;
                        Rectangle {
                            border-radius: 6px;
                            background: AppColors.green;
                            opacity: 0.1;
                            width: 100%; height: 100%;
                        }
                        HorizontalLayout { padding: 10px; spacing: 8px;
                            Text { text: "✓"; color: AppColors.green; font-size: 16px; }
                            VerticalLayout { spacing: 2px;
                                Text { text: "Conversion completed successfully!"; color: AppColors.green; font-size: 11px; font-weight: 700; }
                                Text { text: "File saved to: " + root.output-path; color: AppColors.text-muted; font-size: 10px; wrap: word-wrap; }
                            }
                        }
                    }
                    if (root.conv-log != "") : Rectangle {
                        border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                        background: #0D0D0F; min-height: 60px; max-height: 100px;
                        ScrollView {
                            Text { text: root.conv-log; color: #88CC88; font-size: 9px; font-family: "monospace"; wrap: word-wrap; }
                        }
                    }
                    Rectangle {
                        border-radius: 6px; background: AppColors.nested-bg; min-height: 28px; max-width: 200px;
                        TouchArea { clicked => { root.reset-conv(); } }
                        Text { text: "Start New Conversion"; color: AppColors.text-title; font-size: 10px; font-weight: 600;
                               horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                if (root.conv-status == "failed") : VerticalLayout { spacing: 6px;
                    Rectangle {
                        border-radius: 6px;
                        border-width: 1px; border-color: AppColors.red;
                        min-height: 40px;
                        Rectangle {
                            border-radius: 6px;
                            background: AppColors.red;
                            opacity: 0.1;
                            width: 100%; height: 100%;
                        }
                        HorizontalLayout { padding: 10px; spacing: 8px;
                            Text { text: "✗"; color: AppColors.red; font-size: 16px; }
                            Text { text: "Conversion failed"; color: AppColors.red; font-size: 11px; font-weight: 700; }
                        }
                    }
                    Rectangle {
                        border-radius: 6px; border-width: 1px; border-color: AppColors.border-main;
                        background: #0D0D0F; min-height: 80px; max-height: 200px;
                        ScrollView {
                            Text { text: root.conv-log == "" ? "(no output)" : root.conv-log; color: #FF6666; font-size: 9px; font-family: "monospace"; wrap: word-wrap; }
                        }
                    }
                    HorizontalLayout { spacing: 8px;
                        Rectangle {
                            border-radius: 6px; background: AppColors.nested-bg; min-height: 28px; max-width: 140px;
                            TouchArea { clicked => { root.copy-log(); } }
                            Text { text: "📋 Copy Error Log"; color: AppColors.text-title; font-size: 10px; font-weight: 600;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            border-radius: 6px; background: AppColors.nested-bg; min-height: 28px; max-width: 120px;
                            TouchArea { clicked => { root.reset-conv(); } }
                            Text { text: "Try Again"; color: AppColors.text-title; font-size: 10px; font-weight: 600;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}

// ── Main App Window ────────────────────────────────────────────────────────

export component AppWindow inherits Window {
    title: "LTC Timecode Generator";
    maximized: true;

    // ── Clock properties ──
    in-out property <string> tc-hh: "01";
    in-out property <string> tc-sep1: ":";
    in-out property <string> tc-mm: "00";
    in-out property <string> tc-sep2: ":";
    in-out property <string> tc-ss: "00";
    in-out property <string> tc-sep3: ":";
    in-out property <string> tc-ff: "00";
    in-out property <string> ms-text: "01:00:00.000";
    in-out property <bool> is-playing: false;
    in-out property <bool> is-locked: false;
    in-out property <string> fps-name: "25 fps";
    in-out property <string> ltc-route: "LEFT";
    in-out property <string> beep-route: "RIGHT";

    // ── Clapper properties ──
    in-out property <int> scene: 1;
    in-out property <int> take: 1;
    in-out property <string> roll: "A001";
    in-out property <bool> auto-increment: true;
    in-out property <[LogEntry]> logs: [];
    in-out property <float> arm-angle: -0.43633;
    in-out property <bool> copy-confirmed: false;

    // ── Flash overlay ──
    in-out property <float> flash-opacity: 0.0;

    // ── Pulse animation ──
    in-out property <float> pulse-phase: 0.0;

    // ── Toasts ──
    in-out property <[ToastData]> toasts: [];

    // ── Settings properties ──
    in-out property <int> hour: 1;
    in-out property <int> minute: 0;
    in-out property <int> second: 0;
    in-out property <int> frame: 0;
    in-out property <int> max-frame: 25;
    in-out property <int> fps-index: 1;
    in-out property <[FrameRateOption]> fps-options: [];
    in-out property <int> sample-rate-index: 0;
    in-out property <[string]> sample-rate-options: ["16000 Hz", "48000 Hz"];
    in-out property <int> device-index: 0;
    in-out property <[string]> device-names: [];
    in-out property <int> ltc-channel-index: 0;
    in-out property <int> beep-channel-index: 1;
    in-out property <float> ltc-volume: 0.25;
    in-out property <float> beep-volume: 0.5;
    in-out property <float> beep-frequency: 1000.0;
    in-out property <float> beep-duration: 0.5;

    // ── Header metadata ──
    in-out property <string> sample-rate-khz: "48.0";
    in-out property <int> buffer-size: 0;

    // ── Status properties ──
    in-out property <string> os-name: "LINUX";
    in-out property <int> device-count: 0;
    in-out property <string> sample-format: "";
    in-out property <bool> wake-lock-active: false;
    in-out property <string> system-time: "12:00:00 UTC";
    in-out property <string> status-message: "Ready";
    in-out property <string> power-status: "AC";

    // ── Debug log ──
    in-out property <bool> show-debug-log: false;
    in-out property <[string]> debug-log-entries: [];

    // ── Converter properties ──
    in-out property <bool> conv-has-ffmpeg: false;
    in-out property <string> conv-ffmpeg-error: "";
    in-out property <string> conv-selected-folder: "";
    in-out property <[FileGroupInfo]> conv-file-groups: [];
    in-out property <int> conv-selected-group-idx: -1;
    in-out property <int> conv-num-channels: 0;
    in-out property <[int]> conv-channel-map: [];
    in-out property <string> conv-container: "mkv";
    in-out property <string> conv-video-encoder: "libsvtav1";
    in-out property <string> conv-audio-encoder: "pcm_s24le";
    in-out property <string> conv-output-path: "";
    in-out property <string> conv-status: "idle";
    in-out property <float> conv-progress: 0.0;
    in-out property <string> conv-log: "";
    in-out property <string> conv-sanity-msg: "";

    // ── Tab state ──
    in-out property <int> active-tab: 0;
    in-out property <bool> show-faq: false;

    // ── Version (set from Rust) ──
    in-out property <string> version: "";

    // ── Clock callbacks ──
    callback start-ltc;
    callback stop-ltc;
    callback clap-beep;
    callback reset-tc;
    callback toggle-lock;

    // ── Clapper callbacks ──
    callback scene-up;
    callback scene-down;
    callback take-up;
    callback take-down;
    callback roll-changed;
    callback auto-increment-toggled;
    callback clear-logs;
    callback copy-logs;

    // ── Settings callbacks ──
    callback hour-up;
    callback hour-down;
    callback minute-up;
    callback minute-down;
    callback second-up;
    callback second-down;
    callback frame-up;
    callback frame-down;
    callback fps-selected(int);
    callback sample-rate-tapped(string);
    callback device-selected(int);
    callback ltc-channel-selected(int);
    callback beep-channel-selected(int);
    callback ltc-volume-changed(float);
    callback beep-volume-changed(float);
    callback beep-frequency-changed(float);
    callback beep-duration-changed(float);
    callback refresh-devices;
    callback dismiss-toast(int);

    // ── Converter callbacks ──
    callback conv-select-folder;
    callback conv-select-group(int);
    callback conv-map-cell-clicked(int, int);
    callback conv-start;
    callback conv-cancel;
    callback conv-copy-log;
    callback conv-reset;

    // ── Tab navigation ──
    callback tab-clicked(int);

    // ── Theme ──
    callback toggle-theme;

    // ── Debug log ──
    callback toggle-debug-log;
    callback clear-debug-log;

    // ── Keyboard shortcuts ──
    FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                if (root.is-playing) { root.stop-ltc(); } else { root.start-ltc(); }
                accept
            } else if (event.text == "c" || event.text == "C") {
                if (!root.is-locked) { root.clap-beep(); }
                accept
            } else if (event.text == "r" || event.text == "R") {
                if (!root.is-playing && !root.is-locked) { root.reset-tc(); }
                accept
            } else if (event.text == "l" || event.text == "L") {
                root.toggle-lock();
                accept
            } else if (event.modifiers.control && (event.text == "d" || event.text == "D")) {
                root.toggle-debug-log();
                accept
            } else {
                reject
            }
        }
    }

    // ── Main Layout ──
    Rectangle {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        background: AppColors.app-bg;
        VerticalLayout {
        spacing: 0px;

        // Header
        Rectangle {
            min-height: 44px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 4px;
                // Logo (click toggles debug log)
                Rectangle {
                    width: 34px; height: 34px;
                    border-radius: 4px;
                    background: AppColors.accent;
                    VerticalLayout {
                        spacing: 3px;
                        alignment: center;
                        Rectangle { width: 18px; height: 2px; background: black; }
                        Rectangle { width: 18px; height: 2px; background: black; }
                    }
                    TouchArea {
                        clicked => { root.toggle-debug-log(); }
                    }
                }
                // Title
                VerticalLayout {
                    spacing: 0px;
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: "LTC ENGINE";
                            color: AppColors.text-title;
                            font-size: 16px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.version;
                            color: AppColors.accent;
                            font-size: 16px;
                            font-weight: 700;
                        }
                    }
                    Text {
                        text: "LINEAR TIMECODE HUB";
                        color: AppColors.text-muted;
                        font-size: 9px;
                        font-weight: 700;
                    }
                }
                // Metadata indicators
                HorizontalLayout {
                    spacing: 10px;
                    // Interface status
                    Rectangle {
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: AppColors.border-main;
                        background: AppColors.nested-bg;
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 1px;
                            Text {
                                text: "INTERFACE";
                                color: AppColors.text-muted;
                                font-size: 8px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.is-playing ? "NATIVE ACTIVE" : "STANDBY";
                                color: root.is-playing ? AppColors.green : AppColors.amber;
                                font-size: 10px;
                                font-weight: 700;
                            }
                        }
                    }
                    // Sample Rate
                    Rectangle {
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: AppColors.border-main;
                        background: AppColors.nested-bg;
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 1px;
                            Text {
                                text: "SAMPLE RATE";
                                color: AppColors.text-muted;
                                font-size: 8px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.sample-rate-khz + " KHZ";
                                color: AppColors.text-title;
                                font-size: 10px;
                                font-weight: 700;
                            }
                        }
                    }
                    // Buffer
                    Rectangle {
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: AppColors.border-main;
                        background: AppColors.nested-bg;
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 1px;
                            Text {
                                text: "BUFFER";
                                color: AppColors.text-muted;
                                font-size: 8px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.buffer-size + " SMP";
                                color: AppColors.text-title;
                                font-size: 10px;
                                font-weight: 700;
                            }
                        }
                    }
                }
                // Spacer + system time + ? button
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Rectangle {
                        border-radius: 6px;
                        background: AppColors.nested-bg;
                        border-width: 1px;
                        border-color: AppColors.border-main;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            Text {
                                text: root.system-time;
                                color: AppColors.text-muted;
                                font-size: 9px;
                                font-weight: 700;
                            }
                        }
                    }
                    Rectangle {
                        width: 24px; height: 24px;
                        border-radius: 6px;
                        background: AppColors.nested-bg;
                        Text {
                            text: AppColors.theme-dark ? "☀" : "🌙";
                            color: AppColors.text-title;
                            font-weight: 700;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.toggle-theme(); }
                        }
                    }
                    Rectangle {
                        width: 24px; height: 24px;
                        border-radius: 6px;
                        background: AppColors.nested-bg;
                        Text {
                            text: "?";
                            color: AppColors.text-title;
                            font-weight: 700;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.show-faq = !root.show-faq; }
                        }
                    }
                }
            }
        }

        // FAQ panel (collapsible)
        if (root.show-faq) : Rectangle {
            background: AppColors.card-bg;
            border-radius: 12px;
            border-width: 1.5px;
            border-color: AppColors.border-main;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 8px;
                Text {
                    text: "LTC & MULTI-CAM SYNC - QUICK GUIDE";
                    color: AppColors.text-title;
                    font-size: 13px;
                    font-weight: 700;
                }
                Text {
                    text: "📻 WHAT IS LINEAR TIMECODE?\nLinear Timecode (LTC) is an analog audio signal encoding SMPTE timecode (Hours:Minutes:Seconds:Frames) using Bi-Phase Mark Modulation. Cameras and recorders listen to this audio signal to align footage in post.";
                    color: AppColors.text-muted;
                    font-size: 10.5px;
                    wrap: word-wrap;
                }
                Text {
                    text: "🎥 CONNECTING CAMERAS\nConnect your device's audio output (line/jack) directly to the mic input of your cameras, or dedicated sync boxes (Tentacle, Deity). Set camera audio gain manually to a medium level.";
                    color: AppColors.text-muted;
                    font-size: 10.5px;
                    wrap: word-wrap;
                }
                Text {
                    text: "🔊 SYNCHRONIZING IN EDIT\nImport all media files into DaVinci Resolve, Premiere, or Final Cut Pro. Right-click files and choose 'Update Timecode from Audio Track'. The software matches alignment instantly!";
                    color: AppColors.text-muted;
                    font-size: 10.5px;
                    wrap: word-wrap;
                }
                Rectangle {
                    min-width: 80px; min-height: 28px;
                    border-radius: 6px;
                    background: AppColors.card-bg;
                    border-width: 1px;
                    border-color: AppColors.border-main;
                    TouchArea { clicked => { root.show-faq = false; } }
                    Text { text: "Got it"; color: AppColors.text-title; font-weight: 600; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        // Content area (fills remaining vertical space)
        Rectangle {
            vertical-stretch: 1;
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Rectangle {
                    preferred-width: 720px;
                    max-width: 720px;
                    min-width: 0px;
                    clip: true;
                    VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;

                // Clock section (fixed height, no vertical stretch)
                ClockSection {
                    vertical-stretch: 0;
                    tc-hh: root.tc-hh;
                    tc-sep1: root.tc-sep1;
                    tc-mm: root.tc-mm;
                    tc-sep2: root.tc-sep2;
                    tc-ss: root.tc-ss;
                    tc-sep3: root.tc-sep3;
                    tc-ff: root.tc-ff;
                    ms-text: root.ms-text;
                    is-playing: root.is-playing;
                    is-locked: root.is-locked;
                    fps-name: root.fps-name;
                    ltc-route: root.ltc-route;
                    beep-route: root.beep-route;
                    pulse-phase: root.pulse-phase;
                    start-ltc => { root.start-ltc(); }
                    stop-ltc => { root.stop-ltc(); }
                    clap-beep => { root.clap-beep(); }
                    reset-tc => { root.reset-tc(); }
                    toggle-lock => { root.toggle-lock(); }
                }

                // Tab bar (fixed height, no vertical stretch)
                HorizontalLayout {
                    vertical-stretch: 0;
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 0px;
                    Rectangle {
                        width: 33%;
                        TouchArea {
                            clicked => { root.tab-clicked(0); }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: "Clapper";
                                color: root.active-tab == 0 ? AppColors.text-title : AppColors.text-muted;
                                font-size: 11px;
                                font-weight: root.active-tab == 0 ? 700 : 400;
                                horizontal-alignment: center;
                            }
                            if (root.active-tab == 0) : Rectangle {
                                height: 2px;
                                background: AppColors.accent;
                            }
                        }
                    }
                    Rectangle {
                        width: 33%;
                        TouchArea {
                            clicked => { root.tab-clicked(1); }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: "Settings";
                                color: root.active-tab == 1 ? AppColors.text-title : AppColors.text-muted;
                                font-size: 11px;
                                font-weight: root.active-tab == 1 ? 700 : 400;
                                horizontal-alignment: center;
                            }
                            if (root.active-tab == 1) : Rectangle {
                                height: 2px;
                                background: AppColors.accent;
                            }
                        }
                    }
                    Rectangle {
                        width: 34%;
                        TouchArea {
                            clicked => { root.tab-clicked(2); }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: "Converter";
                                color: root.active-tab == 2 ? AppColors.text-title : AppColors.text-muted;
                                font-size: 11px;
                                font-weight: root.active-tab == 2 ? 700 : 400;
                                horizontal-alignment: center;
                            }
                            if (root.active-tab == 2) : Rectangle {
                                height: 2px;
                                background: AppColors.accent;
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 0; height: 1px; background: AppColors.border-main; }

                // Tab content (stretches to fill remaining height)
                if (root.active-tab == 0) : ClapperSection {
                    scene: root.scene;
                    take: root.take;
                    roll: root.roll;
                    auto-increment: root.auto-increment;
                    logs: root.logs;
                    arm-angle: root.arm-angle;
                    copy-confirmed: root.copy-confirmed;
                    scene-up => { root.scene-up(); }
                    scene-down => { root.scene-down(); }
                    take-up => { root.take-up(); }
                    take-down => { root.take-down(); }
                    roll-changed => { root.roll-changed(); }
                    auto-increment-toggled => { root.auto-increment-toggled(); }
                    clap-beep => { root.clap-beep(); }
                    clear-logs => { root.clear-logs(); }
                    copy-logs => { root.copy-logs(); }
                }
                if (root.active-tab == 1) : SettingsSection {
                    hour: root.hour;
                    minute: root.minute;
                    second: root.second;
                    frame: root.frame;
                    max-frame: root.max-frame;
                    fps-index: root.fps-index;
                    fps-options: root.fps-options;
                    sample-rate-index: root.sample-rate-index;
                    sample-rate-options: root.sample-rate-options;
                    device-index: root.device-index;
                    device-names: root.device-names;
                    ltc-channel-index: root.ltc-channel-index;
                    beep-channel-index: root.beep-channel-index;
                    ltc-volume: root.ltc-volume;
                    beep-volume: root.beep-volume;
                    beep-frequency: root.beep-frequency;
                    beep-duration: root.beep-duration;
                    settings-enabled: !root.is-playing;
                    hour-up => { root.hour-up(); }
                    hour-down => { root.hour-down(); }
                    minute-up => { root.minute-up(); }
                    minute-down => { root.minute-down(); }
                    second-up => { root.second-up(); }
                    second-down => { root.second-down(); }
                    frame-up => { root.frame-up(); }
                    frame-down => { root.frame-down(); }
                    fps-selected(val) => { root.fps-selected(val); }
                    sample-rate-tapped(rate_text) => { root.sample-rate-tapped(rate_text); }
                    device-selected(index) => { root.device-selected(index); }
                    ltc-channel-selected(index) => { root.ltc-channel-selected(index); }
                    beep-channel-selected(index) => { root.beep-channel-selected(index); }
                    ltc-volume-changed(val) => { root.ltc-volume-changed(val); }
                    beep-volume-changed(val) => { root.beep-volume-changed(val); }
                    beep-frequency-changed(val) => { root.beep-frequency-changed(val); }
                    beep-duration-changed(val) => { root.beep-duration-changed(val); }
                    refresh-devices => { root.refresh-devices(); }
                }
                if (root.active-tab == 2) : ConverterSection {
                    has-ffmpeg: root.conv-has-ffmpeg;
                    ffmpeg-error: root.conv-ffmpeg-error;
                    selected-folder: root.conv-selected-folder;
                    file-groups: root.conv-file-groups;
                    selected-group-idx: root.conv-selected-group-idx;
                    num-channels: root.conv-num-channels;
                    channel-map: root.conv-channel-map;
                    container: root.conv-container;
                    video-encoder: root.conv-video-encoder;
                    audio-encoder: root.conv-audio-encoder;
                    output-path: root.conv-output-path;
                    conv-status: root.conv-status;
                    conv-progress: root.conv-progress;
                    conv-log: root.conv-log;
                    sanity-msg: root.conv-sanity-msg;
                    select-folder => { root.conv-select-folder(); }
                    select-group(idx) => { root.conv-select-group(idx); }
                    map-cell-clicked(row, col) => { root.conv-map-cell-clicked(row, col); }
                    start-convert => { root.conv-start(); }
                    cancel-convert => { root.conv-cancel(); }
                    copy-log => { root.conv-copy-log(); }
                    reset-conv => { root.conv-reset(); }
                }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
        }
        StatusBar {
            os-name: root.os-name;
            device-count: root.device-count;
            is-playing: root.is-playing;
            sample-format: root.sample-format;
            wake-lock-active: root.wake-lock-active;
            status-message: root.status-message;
            power-status: root.power-status;
        }

        }

        // Full-screen flash overlay (outside layout, absolute positioning)
        if (root.flash-opacity > 0.0) : Rectangle {
            background: white;
            opacity: root.flash-opacity;
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
        }

        // Toast notification overlay (outside layout, absolute positioning)
        if (root.toasts.length > 0) : Rectangle {
            background: transparent;
            x: 0;
            width: 100%;
            y: parent.height - 140px;
            height: 120px;
            VerticalLayout {
                alignment: end;
                spacing: 6px;
                for toast in root.toasts : Rectangle {
                    border-radius: 8px;
                    border-width: 1px;
                    background: toast.toast-type == "error" ? #DC2626E6 :
                               (toast.toast-type == "warning" ? #F59E0BE6 :
                               (toast.toast-type == "success" ? #22C55EE6 :
                               (AppColors.theme-dark ? #1E1E23F2 : #F4F4F6F2)));
                    border-color: toast.toast-type == "error" ? AppColors.red :
                                 (toast.toast-type == "warning" ? AppColors.amber :
                                 (toast.toast-type == "success" ? AppColors.green :
                                 AppColors.border-main));
                    min-height: 36px;
                    max-width: 400px;
                    opacity: toast.opacity;
                    animate opacity { duration: 300ms; }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        Text {
                            text: toast.toast-type == "error" ? "✕" :
                                 (toast.toast-type == "warning" ? "⚠" :
                                 (toast.toast-type == "success" ? "✓" : "ℹ"));
                            color: white;
                            font-weight: 700;
                            font-size: 14px;
                        }
                        Text {
                            text: toast.message;
                            color: white;
                            font-size: 11px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                    }
                    TouchArea { clicked => { root.dismiss-toast(toast.id); } }
                }
            }
        }

        // Debug log window overlay (outside layout, absolute positioning)
        if (root.show-debug-log) : Rectangle {
            x: parent.width - 420px;
            y: 50px;
            width: 400px;
            height: 300px;
            background: AppColors.card-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppColors.border-main;
            VerticalLayout {
                spacing: 4px;
                padding: 8px;
                // Header
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "DEBUG LOG";
                        color: AppColors.text-title;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 50px; height: 22px;
                        border-radius: 4px;
                        background: AppColors.nested-bg;
                        border-width: 1px;
                        border-color: AppColors.border-main;
                        TouchArea { clicked => { root.clear-debug-log(); } }
                        Text {
                            text: "Clear";
                            color: AppColors.text-muted;
                            font-size: 10px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 22px; height: 22px;
                        border-radius: 4px;
                        background: AppColors.nested-bg;
                        TouchArea { clicked => { root.show-debug-log = false; } }
                        Text {
                            text: "✕";
                            color: AppColors.text-muted;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                // Log entries list
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 2px;
                        if (root.debug-log-entries.length == 0) : Text {
                            text: "No debug log entries yet.";
                            color: AppColors.text-muted;
                            font-size: 10px;
                        }
                        for entry in root.debug-log-entries : Text {
                            text: entry;
                            color: AppColors.text-main;
                            font-size: 9px;
                            font-family: "monospace";
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}