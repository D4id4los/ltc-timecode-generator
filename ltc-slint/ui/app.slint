import { AppColors } from "./theme.slint";
export { AppColors } from "./theme.slint";
import { LogEntry, FrameRateOption, ToastData, FileGroupInfo } from "./types.slint";
import { ClockSection } from "./clock.slint";
import { ClapperSection } from "./clapper.slint";
import { SettingsSection } from "./settings.slint";
import { StatusBar } from "./status.slint";
import { ConverterSection } from "./converter.slint";
import { ScrollView } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "LTC Timecode Generator";
    maximized: true;

    // ── Clock properties ──
    in-out property <string> tc-hh: "01";
    in-out property <string> tc-sep1: ":";
    in-out property <string> tc-mm: "00";
    in-out property <string> tc-sep2: ":";
    in-out property <string> tc-ss: "00";
    in-out property <string> tc-sep3: ":";
    in-out property <string> tc-ff: "00";
    in-out property <string> ms-text: "01:00:00.000";
    in-out property <bool> is-playing: false;
    in-out property <bool> is-locked: false;
    in-out property <string> fps-name: "25 fps";
    in-out property <string> ltc-route: "LEFT";
    in-out property <string> beep-route: "RIGHT";

    // ── Clapper properties ──
    in-out property <int> scene: 1;
    in-out property <int> take: 1;
    in-out property <string> roll: "A001";
    in-out property <bool> auto-increment: true;
    in-out property <[LogEntry]> logs: [];
    in-out property <float> arm-angle: -0.43633;
    in-out property <bool> copy-confirmed: false;

    // ── Flash overlay ──
    in-out property <float> flash-opacity: 0.0;

    // ── Pulse animation ──
    in-out property <float> pulse-phase: 0.0;

    // ── Toasts ──
    in-out property <[ToastData]> toasts: [];

    // ── Settings properties ──
    in-out property <int> hour: 1;
    in-out property <int> minute: 0;
    in-out property <int> second: 0;
    in-out property <int> frame: 0;
    in-out property <int> max-frame: 25;
    in-out property <int> fps-index: 1;
    in-out property <[FrameRateOption]> fps-options: [];
    in-out property <int> sample-rate-index: 0;
    in-out property <[string]> sample-rate-options: ["44100 Hz", "48000 Hz"];
    in-out property <int> device-index: 0;
    in-out property <[string]> device-names: [];
    in-out property <int> ltc-channel-index: 0;
    in-out property <int> beep-channel-index: 1;
    in-out property <float> ltc-volume: 0.25;
    in-out property <float> beep-volume: 0.5;
    in-out property <float> beep-frequency: 1000.0;
    in-out property <float> beep-duration: 0.5;

    // ── Header metadata ──
    in-out property <string> sample-rate-khz: "48.0";
    in-out property <int> buffer-size: 0;

    // ── Status properties ──
    in-out property <string> os-name: "LINUX";
    in-out property <int> device-count: 0;
    in-out property <string> sample-format: "";
    in-out property <bool> wake-lock-active: false;
    in-out property <string> system-time: "12:00:00 UTC";
    in-out property <string> status-message: "Ready";
    in-out property <string> power-status: "AC";

    // ── Debug log ──
    in-out property <bool> show-debug-log: false;
    in-out property <[string]> debug-log-entries: [];

    // ── Converter properties ──
    in-out property <bool> conv-has-ffmpeg: false;
    in-out property <string> conv-ffmpeg-error: "";
    in-out property <string> conv-selected-folder: "";
    in-out property <[FileGroupInfo]> conv-file-groups: [];
    in-out property <int> conv-selected-group-idx: -1;
    in-out property <int> conv-num-channels: 0;
    in-out property <[int]> conv-channel-map: [];
    in-out property <string> conv-container: "mkv";
    in-out property <string> conv-video-encoder: "libsvtav1";
    in-out property <string> conv-audio-encoder: "pcm_s24le";
    in-out property <string> conv-output-path: "";
    in-out property <string> conv-status: "idle";
    in-out property <float> conv-progress: 0.0;
    in-out property <string> conv-log: "";
    in-out property <string> conv-sanity-msg: "";
    in-out property <int> conv-selected-pattern: 0;
    in-out property <[string]> conv-container-options: [];
    in-out property <[string]> conv-video-encoder-options: [];
    in-out property <[string]> conv-audio-encoder-options: [];
    in-out property <bool> trim-to-first-ltc: false;
    in-out property <float> trim-offset-secs: 0.0;

    // ── LTC detection properties ──
    in-out property <int> ltc-file-idx: 0;
    in-out property <[string]> ltc-file-names: [];
    in-out property <string> ltc-status: "";
    in-out property <string> ltc-result-text: "";
    in-out property <string> ltc-error: "";
    in-out property <[string]> decode-fps-options: [];
    in-out property <int> decode-fps-index: 1;
    in-out property <float> ltc-decode-progress: 0.0;

    // ── Tab state ──
    in-out property <int> active-tab: 0;
    in-out property <bool> show-faq: false;

    // ── Version (set from Rust) ──
    in-out property <string> version: "";

    // ── Clock callbacks ──
    callback start-ltc;
    callback stop-ltc;
    callback clap-beep;
    callback reset-tc;
    callback toggle-lock;

    // ── Clapper callbacks ──
    callback scene-up;
    callback scene-down;
    callback take-up;
    callback take-down;
    callback roll-changed;
    callback auto-increment-toggled;
    callback clear-logs;
    callback copy-logs;

    // ── Settings callbacks ──
    callback hour-up;
    callback hour-down;
    callback minute-up;
    callback minute-down;
    callback second-up;
    callback second-down;
    callback frame-up;
    callback frame-down;
    callback fps-selected(int);
    callback sample-rate-tapped(string);
    callback device-selected(int);
    callback ltc-channel-selected(int);
    callback beep-channel-selected(int);
    callback ltc-volume-changed(float);
    callback beep-volume-changed(float);
    callback beep-frequency-changed(float);
    callback beep-duration-changed(float);
    callback refresh-devices;
    callback dismiss-toast(int);

    // ── LTC detection callbacks ──
    callback ltc-detect;
    callback decode-fps-selected(int);
    callback cancel-decode;

    // ── Converter callbacks ──
    callback conv-select-folder;
    callback conv-select-group(int);
    callback conv-map-cell-clicked(int, int);
    callback conv-start;
    callback conv-cancel;
    callback conv-copy-log;
    callback conv-copy-ltc-report;
    callback conv-reset;
    callback conv-container-selected(int);
    callback conv-video-selected(int);
    callback conv-audio-selected(int);
    callback conv-select-output-path;
    callback conv-select-pattern(int);
    callback toggle-trim-ltc;

    // ── Tab navigation ──
    callback tab-clicked(int);

    // ── Theme ──
    callback toggle-theme;

    // ── Debug log ──
    callback toggle-debug-log;
    callback clear-debug-log;

    // ── Keyboard shortcuts ──
    FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                if (root.is-playing) { root.stop-ltc(); } else { root.start-ltc(); }
                accept
            } else if (event.text == "c" || event.text == "C") {
                if (!root.is-locked) { root.clap-beep(); }
                accept
            } else if (event.text == "r" || event.text == "R") {
                if (!root.is-playing && !root.is-locked) { root.reset-tc(); }
                accept
            } else if (event.text == "l" || event.text == "L") {
                root.toggle-lock();
                accept
            } else if (event.modifiers.control && (event.text == "d" || event.text == "D")) {
                root.toggle-debug-log();
                accept
            } else {
                reject
            }
        }
    }

    // ── Main Layout ──
    Rectangle {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        background: AppColors.app-bg;
        VerticalLayout {
        spacing: 0px;

        // Header
        Rectangle {
            min-height: 44px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 4px;
                // Logo (click toggles debug log)
                Rectangle {
                    width: 34px; height: 34px;
                    border-radius: 4px;
                    background: AppColors.accent;
                    VerticalLayout {
                        spacing: 3px;
                        alignment: center;
                        Rectangle { width: 18px; height: 2px; background: black; }
                        Rectangle { width: 18px; height: 2px; background: black; }
                    }
                    TouchArea {
                        clicked => { root.toggle-debug-log(); }
                    }
                }
                // Title
                VerticalLayout {
                    spacing: 0px;
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: "LTC ENGINE";
                            color: AppColors.text-title;
                            font-size: 16px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.version;
                            color: AppColors.accent;
                            font-size: 16px;
                            font-weight: 700;
                        }
                    }
                    Text {
                        text: "LINEAR TIMECODE HUB";
                        color: AppColors.text-muted;
                        font-size: 9px;
                        font-weight: 700;
                    }
                }
                // Metadata indicators
                HorizontalLayout {
                    spacing: 10px;
                    // Interface status
                    Rectangle {
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: AppColors.border-main;
                        background: AppColors.nested-bg;
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 1px;
                            Text {
                                text: "INTERFACE";
                                color: AppColors.text-muted;
                                font-size: 8px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.is-playing ? "NATIVE ACTIVE" : "STANDBY";
                                color: root.is-playing ? AppColors.green : AppColors.amber;
                                font-size: 10px;
                                font-weight: 700;
                            }
                        }
                    }
                    // Sample Rate
                    Rectangle {
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: AppColors.border-main;
                        background: AppColors.nested-bg;
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 1px;
                            Text {
                                text: "SAMPLE RATE";
                                color: AppColors.text-muted;
                                font-size: 8px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.sample-rate-khz + " KHZ";
                                color: AppColors.text-title;
                                font-size: 10px;
                                font-weight: 700;
                            }
                        }
                    }
                    // Buffer
                    Rectangle {
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: AppColors.border-main;
                        background: AppColors.nested-bg;
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 1px;
                            Text {
                                text: "BUFFER";
                                color: AppColors.text-muted;
                                font-size: 8px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.buffer-size + " SMP";
                                color: AppColors.text-title;
                                font-size: 10px;
                                font-weight: 700;
                            }
                        }
                    }
                }
                // Spacer + system time + ? button
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Rectangle {
                        border-radius: 6px;
                        background: AppColors.nested-bg;
                        border-width: 1px;
                        border-color: AppColors.border-main;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            Text {
                                text: root.system-time;
                                color: AppColors.text-muted;
                                font-size: 9px;
                                font-weight: 700;
                            }
                        }
                    }
                    Rectangle {
                        width: 24px; height: 24px;
                        border-radius: 6px;
                        background: AppColors.nested-bg;
                        Text {
                            text: AppColors.theme-dark ? "☀" : "🌙";
                            color: AppColors.text-title;
                            font-weight: 700;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.toggle-theme(); }
                        }
                    }
                    Rectangle {
                        width: 24px; height: 24px;
                        border-radius: 6px;
                        background: AppColors.nested-bg;
                        Text {
                            text: "?";
                            color: AppColors.text-title;
                            font-weight: 700;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.show-faq = !root.show-faq; }
                        }
                    }
                }
            }
        }

        // FAQ panel (collapsible)
        if (root.show-faq) : Rectangle {
            background: AppColors.card-bg;
            border-radius: 12px;
            border-width: 1.5px;
            border-color: AppColors.border-main;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 8px;
                Text {
                    text: "LTC & MULTI-CAM SYNC - QUICK GUIDE";
                    color: AppColors.text-title;
                    font-size: 13px;
                    font-weight: 700;
                }
                Text {
                    text: "📻 WHAT IS LINEAR TIMECODE?\nLinear Timecode (LTC) is an analog audio signal encoding SMPTE timecode (Hours:Minutes:Seconds:Frames) using Bi-Phase Mark Modulation. Cameras and recorders listen to this audio signal to align footage in post.";
                    color: AppColors.text-muted;
                    font-size: 10.5px;
                    wrap: word-wrap;
                }
                Text {
                    text: "🎥 CONNECTING CAMERAS\nConnect your device's audio output (line/jack) directly to the mic input of your cameras, or dedicated sync boxes (Tentacle, Deity). Set camera audio gain manually to a medium level.";
                    color: AppColors.text-muted;
                    font-size: 10.5px;
                    wrap: word-wrap;
                }
                Text {
                    text: "🔊 SYNCHRONIZING IN EDIT\nImport all media files into DaVinci Resolve, Premiere, or Final Cut Pro. Right-click files and choose 'Update Timecode from Audio Track'. The software matches alignment instantly!";
                    color: AppColors.text-muted;
                    font-size: 10.5px;
                    wrap: word-wrap;
                }
                Rectangle {
                    min-width: 80px; min-height: 28px;
                    border-radius: 6px;
                    background: AppColors.card-bg;
                    border-width: 1px;
                    border-color: AppColors.border-main;
                    TouchArea { clicked => { root.show-faq = false; } }
                    Text { text: "Got it"; color: AppColors.text-title; font-weight: 600; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        // Content area (fills remaining vertical space)
        Rectangle {
            vertical-stretch: 1;
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Rectangle {
                    preferred-width: 720px;
                    max-width: 720px;
                    min-width: 0px;
                    clip: true;
                    VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;

                // Clock section (fixed height, no vertical stretch)
                ClockSection {
                    vertical-stretch: 0;
                    tc-hh: root.tc-hh;
                    tc-sep1: root.tc-sep1;
                    tc-mm: root.tc-mm;
                    tc-sep2: root.tc-sep2;
                    tc-ss: root.tc-ss;
                    tc-sep3: root.tc-sep3;
                    tc-ff: root.tc-ff;
                    ms-text: root.ms-text;
                    is-playing: root.is-playing;
                    is-locked: root.is-locked;
                    fps-name: root.fps-name;
                    ltc-route: root.ltc-route;
                    beep-route: root.beep-route;
                    pulse-phase: root.pulse-phase;
                    start-ltc => { root.start-ltc(); }
                    stop-ltc => { root.stop-ltc(); }
                    clap-beep => { root.clap-beep(); }
                    reset-tc => { root.reset-tc(); }
                    toggle-lock => { root.toggle-lock(); }
                }

                // Tab bar (fixed height, no vertical stretch)
                HorizontalLayout {
                    vertical-stretch: 0;
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 0px;
                    Rectangle {
                        width: 33%;
                        TouchArea {
                            clicked => { root.tab-clicked(0); }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: "Clapper";
                                color: root.active-tab == 0 ? AppColors.text-title : AppColors.text-muted;
                                font-size: 11px;
                                font-weight: root.active-tab == 0 ? 700 : 400;
                                horizontal-alignment: center;
                            }
                            if (root.active-tab == 0) : Rectangle {
                                height: 2px;
                                background: AppColors.accent;
                            }
                        }
                    }
                    Rectangle {
                        width: 33%;
                        TouchArea {
                            clicked => { root.tab-clicked(1); }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: "Settings";
                                color: root.active-tab == 1 ? AppColors.text-title : AppColors.text-muted;
                                font-size: 11px;
                                font-weight: root.active-tab == 1 ? 700 : 400;
                                horizontal-alignment: center;
                            }
                            if (root.active-tab == 1) : Rectangle {
                                height: 2px;
                                background: AppColors.accent;
                            }
                        }
                    }
                    Rectangle {
                        width: 34%;
                        TouchArea {
                            clicked => { root.tab-clicked(2); }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: "Converter";
                                color: root.active-tab == 2 ? AppColors.text-title : AppColors.text-muted;
                                font-size: 11px;
                                font-weight: root.active-tab == 2 ? 700 : 400;
                                horizontal-alignment: center;
                            }
                            if (root.active-tab == 2) : Rectangle {
                                height: 2px;
                                background: AppColors.accent;
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 0; height: 1px; background: AppColors.border-main; }

                // Tab content (stretches to fill remaining height)
                if (root.active-tab == 0) : ClapperSection {
                    scene: root.scene;
                    take: root.take;
                    roll: root.roll;
                    auto-increment: root.auto-increment;
                    logs: root.logs;
                    arm-angle: root.arm-angle;
                    copy-confirmed: root.copy-confirmed;
                    scene-up => { root.scene-up(); }
                    scene-down => { root.scene-down(); }
                    take-up => { root.take-up(); }
                    take-down => { root.take-down(); }
                    roll-changed => { root.roll-changed(); }
                    auto-increment-toggled => { root.auto-increment-toggled(); }
                    clap-beep => { root.clap-beep(); }
                    clear-logs => { root.clear-logs(); }
                    copy-logs => { root.copy-logs(); }
                }
                if (root.active-tab == 1) : SettingsSection {
                    hour: root.hour;
                    minute: root.minute;
                    second: root.second;
                    frame: root.frame;
                    max-frame: root.max-frame;
                    fps-index: root.fps-index;
                    fps-options: root.fps-options;
                    sample-rate-index: root.sample-rate-index;
                    sample-rate-options: root.sample-rate-options;
                    device-index: root.device-index;
                    device-names: root.device-names;
                    ltc-channel-index: root.ltc-channel-index;
                    beep-channel-index: root.beep-channel-index;
                    ltc-volume: root.ltc-volume;
                    beep-volume: root.beep-volume;
                    beep-frequency: root.beep-frequency;
                    beep-duration: root.beep-duration;
                    settings-enabled: !root.is-playing;
                    hour-up => { root.hour-up(); }
                    hour-down => { root.hour-down(); }
                    minute-up => { root.minute-up(); }
                    minute-down => { root.minute-down(); }
                    second-up => { root.second-up(); }
                    second-down => { root.second-down(); }
                    frame-up => { root.frame-up(); }
                    frame-down => { root.frame-down(); }
                    fps-selected(val) => { root.fps-selected(val); }
                    sample-rate-tapped(rate_text) => { root.sample-rate-tapped(rate_text); }
                    device-selected(index) => { root.device-selected(index); }
                    ltc-channel-selected(index) => { root.ltc-channel-selected(index); }
                    beep-channel-selected(index) => { root.beep-channel-selected(index); }
                    ltc-volume-changed(val) => { root.ltc-volume-changed(val); }
                    beep-volume-changed(val) => { root.beep-volume-changed(val); }
                    beep-frequency-changed(val) => { root.beep-frequency-changed(val); }
                    beep-duration-changed(val) => { root.beep-duration-changed(val); }
                    refresh-devices => { root.refresh-devices(); }
                }
                if (root.active-tab == 2) : ConverterSection {
                    ltc-file-idx: root.ltc-file-idx;
                    ltc-file-names: root.ltc-file-names;
                    ltc-status: root.ltc-status;
                    ltc-result-text: root.ltc-result-text;
                    ltc-error: root.ltc-error;
                    decode-fps-options: root.decode-fps-options;
                    decode-fps-index: root.decode-fps-index;
                    ltc-decode-progress: root.ltc-decode-progress;
                    detect-ltc => { root.ltc-detect(); }
                    decode-fps-selected(val) => { root.decode-fps-selected(val); }
                    cancel-decode => { root.cancel-decode(); }
                    has-ffmpeg: root.conv-has-ffmpeg;
                    ffmpeg-error: root.conv-ffmpeg-error;
                    selected-folder: root.conv-selected-folder;
                    file-groups: root.conv-file-groups;
                    selected-group-idx: root.conv-selected-group-idx;
                    num-channels: root.conv-num-channels;
                    channel-map: root.conv-channel-map;
                    container: root.conv-container;
                    video-encoder: root.conv-video-encoder;
                    audio-encoder: root.conv-audio-encoder;
                    output-path: root.conv-output-path;
                    conv-status: root.conv-status;
                    conv-progress: root.conv-progress;
                    conv-log: root.conv-log;
                    sanity-msg: root.conv-sanity-msg;
                    container-options: root.conv-container-options;
                    video-encoder-options: root.conv-video-encoder-options;
                    audio-encoder-options: root.conv-audio-encoder-options;
                    selected-pattern: root.conv-selected-pattern;
                    trim-to-first-ltc: root.trim-to-first-ltc;
                    trim-offset-secs: root.trim-offset-secs;
                    toggle-trim-ltc => { root.toggle-trim-ltc(); }
                    select-folder => { root.conv-select-folder(); }
                    select-group(idx) => { root.conv-select-group(idx); }
                    map-cell-clicked(row, col) => { root.conv-map-cell-clicked(row, col); }
                    start-convert => { root.conv-start(); }
                    cancel-convert => { root.conv-cancel(); }
                    copy-log => { root.conv-copy-log(); }
                    copy-ltc-report => { root.conv-copy-ltc-report(); }
                    reset-conv => { root.conv-reset(); }
                    container-selected(idx) => { root.conv-container-selected(idx); }
                    video-selected(idx) => { root.conv-video-selected(idx); }
                    audio-selected(idx) => { root.conv-audio-selected(idx); }
                    select-output-path => { root.conv-select-output-path(); }
                    select-pattern(idx) => { root.conv-select-pattern(idx); }
                }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
        }
        StatusBar {
            os-name: root.os-name;
            device-count: root.device-count;
            is-playing: root.is-playing;
            sample-format: root.sample-format;
            wake-lock-active: root.wake-lock-active;
            status-message: root.status-message;
            power-status: root.power-status;
        }

        }

        // Full-screen flash overlay (outside layout, absolute positioning)
        if (root.flash-opacity > 0.0) : Rectangle {
            background: white;
            opacity: root.flash-opacity;
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
        }

        // Toast notification overlay (outside layout, absolute positioning)
        if (root.toasts.length > 0) : Rectangle {
            background: transparent;
            x: 0;
            width: 100%;
            y: parent.height - 140px;
            height: 120px;
            VerticalLayout {
                alignment: end;
                spacing: 6px;
                for toast in root.toasts : Rectangle {
                    border-radius: 8px;
                    border-width: 1px;
                    background: toast.toast-type == "error" ? #DC2626E6 :
                               (toast.toast-type == "warning" ? #F59E0BE6 :
                               (toast.toast-type == "success" ? #22C55EE6 :
                               (AppColors.theme-dark ? #1E1E23F2 : #F4F4F6F2)));
                    border-color: toast.toast-type == "error" ? AppColors.red :
                                 (toast.toast-type == "warning" ? AppColors.amber :
                                 (toast.toast-type == "success" ? AppColors.green :
                                 AppColors.border-main));
                    min-height: 36px;
                    max-width: 400px;
                    opacity: toast.opacity;
                    animate opacity { duration: 300ms; }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        Text {
                            text: toast.toast-type == "error" ? "✕" :
                                 (toast.toast-type == "warning" ? "⚠" :
                                 (toast.toast-type == "success" ? "✓" : "ℹ"));
                            color: white;
                            font-weight: 700;
                            font-size: 14px;
                        }
                        Text {
                            text: toast.message;
                            color: white;
                            font-size: 11px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                    }
                    TouchArea { clicked => { root.dismiss-toast(toast.id); } }
                }
            }
        }

        // Debug log window overlay (outside layout, absolute positioning)
        if (root.show-debug-log) : Rectangle {
            x: parent.width - 420px;
            y: 50px;
            width: 400px;
            height: 300px;
            background: AppColors.card-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppColors.border-main;
            VerticalLayout {
                spacing: 4px;
                padding: 8px;
                // Header
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "DEBUG LOG";
                        color: AppColors.text-title;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 50px; height: 22px;
                        border-radius: 4px;
                        background: AppColors.nested-bg;
                        border-width: 1px;
                        border-color: AppColors.border-main;
                        TouchArea { clicked => { root.clear-debug-log(); } }
                        Text {
                            text: "Clear";
                            color: AppColors.text-muted;
                            font-size: 10px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 22px; height: 22px;
                        border-radius: 4px;
                        background: AppColors.nested-bg;
                        TouchArea { clicked => { root.show-debug-log = false; } }
                        Text {
                            text: "✕";
                            color: AppColors.text-muted;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                // Log entries list
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 2px;
                        if (root.debug-log-entries.length == 0) : Text {
                            text: "No debug log entries yet.";
                            color: AppColors.text-muted;
                            font-size: 10px;
                        }
                        for entry in root.debug-log-entries : Text {
                            text: entry;
                            color: AppColors.text-main;
                            font-size: 9px;
                            font-family: "monospace";
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}